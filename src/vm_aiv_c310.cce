template <typename DST_TYPE, typename SRC_TYPE, RoundMode R = RoundMode::CAST_ROUND>
__aicore_inline__ void CastCount(__ubuf__ DST_TYPE *dst, __ubuf__ SRC_TYPE *src0, uint32_t count) {
  __VEC_SCOPE__ {
    RegTensor<SRC_TYPE> vreg0;
    RegTensor<DST_TYPE> vreg1;
    vector_bool exPreg;
    uint32_t sregLower = min(BlockNum(DST_TYPE), BlockNum(SRC_TYPE));
    uint16_t repeat = CeilDiv(count, sregLower);
    constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<DST_TYPE>()>();
    for (uint16_t i = 0; i < repeat; ++i) {
      if constexpr (sizeof(SRC_TYPE) > sizeof(DST_TYPE)) {
        exPreg = UpdateMask<SRC_TYPE>(count);
      } else {
        exPreg = UpdateMask<DST_TYPE>(count);
      }

      if constexpr (sizeof(SRC_TYPE) == 8) {
        vlds((vector_2xvl_s64 &)vreg0, src0, i * sregLower);
      } else if constexpr (sizeof(SRC_TYPE) == 1 && sizeof(DST_TYPE) == 2) {
        vlds(vreg0, src0, i * sregLower, UNPK_B8);
      } else if constexpr (sizeof(SRC_TYPE) == 2 && sizeof(DST_TYPE) == 4) {
        vlds(vreg0, src0, i * sregLower, UNPK_B16);
      } else if constexpr (sizeof(SRC_TYPE) == 1 && sizeof(DST_TYPE) == 4) {
        vlds(vreg0, src0, i * sregLower, UNPK4_B8);
      } else {
        vlds(vreg0, src0, i * sregLower, NORM);
      }

      if constexpr (std::is_same<DST_TYPE, SRC_TYPE>::value) {
        Truncate<DST_TYPE, R>(vreg1, vreg0, exPreg);
      } else if constexpr (std::is_same<DST_TYPE, half>::value && std::is_same<SRC_TYPE, int32_t>::value) {
        RegTensor<float> tmp;
        Cast<float, int32_t, kCastTrait<R>>(tmp, vreg0, exPreg);
        Cast<half, float, kCastTrait<R>>(vreg1, tmp, exPreg);
      } else {
        Cast<DST_TYPE, SRC_TYPE, kCastTrait<R>>(vreg1, vreg0, exPreg);
      }

      if constexpr (sizeof(DST_TYPE) == 8) {
        vsts((vector_2xvl_s64 &)vreg1, dst, i * sregLower, exPreg);
      } else if constexpr (sizeof(DST_TYPE) == 1 && sizeof(SRC_TYPE) == 2) {
        vsts(vreg1, dst, i * sregLower, PK_B16, exPreg);
      } else if constexpr (sizeof(DST_TYPE) == 2 && sizeof(SRC_TYPE) == 4) {
        vsts(vreg1, dst, i * sregLower, PK_B32, exPreg);
      } else if constexpr (sizeof(DST_TYPE) == 1 && sizeof(SRC_TYPE) == 4) {
        vsts(vreg1, dst, i * sregLower, PK4_B32, exPreg);
      } else {
        vsts(vreg1, dst, i * sregLower, distValue, exPreg);
      }
    }
  }
}

template <typename T>
__aicore_inline__ void VectorDupMask(__ubuf__ T *dst, T scalar, uint16_t repeat, uint32_t repeat_offset) {
  __VEC_SCOPE__ {
    RegTensor<T> vreg0;
    vector_bool stPreg;
    constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();
    vbr(vreg0, (T)scalar);
    for (uint16_t i = 0; i < repeat; ++i) {
      stPreg = MoveMask<T>();
      vsts(vreg0, dst, i * repeat_offset, distValue, stPreg);
    }
  }
}

template <typename T>
__aicore_inline__ void VectorDupCount(__ubuf__ T *dst, T scalar, uint32_t count) {
  __VEC_SCOPE__ {
    RegTensor<T> vreg0;
    vector_bool stPreg;
    uint32_t sregLower = BlockNum(T);
    uint16_t repeat = CeilDiv(count, sregLower);
    constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();
    if constexpr (sizeof(T) == 8) {
      vbr((vector_2xvl_s64 &)vreg0, scalar);
    } else {
      vbr(vreg0, scalar);
    }
    for (uint16_t i = 0; i < repeat; ++i) {
      stPreg = UpdateMask<T>(count);
      if constexpr (sizeof(T) == 8) {
        vsts((vector_2xvl_s64 &)vreg0, dst, i * sregLower, stPreg);
      } else {
        vsts(vreg0, dst, i * sregLower, distValue, stPreg);
      }
    }
  }
}

#define UNARY(pc, builtin, head, tile, VTYPE)       \
  do {                                              \
    vUnary op;                                      \
    vUnary::Decode(pc, head, op);                   \
    __ubuf__ VTYPE *xd = (__ubuf__ VTYPE *)(op.xd); \
    __ubuf__ VTYPE *xn = (__ubuf__ VTYPE *)(op.xn); \
    builtin##_count(xd, xn, op.count);              \
  } while (0)

#define BINARY(pc, builtin, head, tile, VTYPE)      \
  do {                                              \
    vBinary op;                                     \
    vBinary::Decode(pc, head, op);                  \
    __ubuf__ VTYPE *xm = (__ubuf__ VTYPE *)(op.xm); \
    __ubuf__ VTYPE *xd = (__ubuf__ VTYPE *)(op.xd); \
    __ubuf__ VTYPE *xn = (__ubuf__ VTYPE *)(op.xn); \
    builtin##_count(xd, xn, xm, op.count);          \
  } while (0)

template <typename DST_TYPE, typename SRC_TYPE, RoundMode R = RoundMode::CAST_ROUND>
__aicore_inline__ void Cast(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vUnary op;
  vUnary::Decode(pc, head, op);
  __ubuf__ DST_TYPE *xd = (__ubuf__ DST_TYPE *)(op.xd);
  __ubuf__ SRC_TYPE *xn = (__ubuf__ SRC_TYPE *)(op.xn);
  CastCount<DST_TYPE, SRC_TYPE, R>(xd, xn, op.count);
}

__aicore_inline__ void LogicalNotBool(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vUnary op;
  vUnary::Decode(pc, head, op);
  __ubuf__ int8_t *xd = (__ubuf__ int8_t *)(op.xd);
  __ubuf__ int8_t *xn = (__ubuf__ int8_t *)(op.xn);
  vsub_count<int8_t, false>(xd, xn, static_cast<int8_t>(1), op.count);
}

#define BINARYS(pc, builtin, head, VTYPE)           \
  do {                                              \
    vBinaryS op;                                    \
    vBinaryS::Decode(pc, head, op);                 \
    __ubuf__ VTYPE *xd = (__ubuf__ VTYPE *)(op.xd); \
    __ubuf__ VTYPE *xn = (__ubuf__ VTYPE *)(op.xn); \
    VTYPE val = vBinaryS::GetScalar<VTYPE>(pc);     \
    builtin##_count(xd, xn, val, op.count);         \
  } while (0)

#define BINARYS_EXT(pc, builtin, head, VTYPE, IsRhs)      \
  do {                                                    \
    vBinaryS op;                                          \
    vBinaryS::Decode(pc, head, op);                       \
    __ubuf__ VTYPE *xd = (__ubuf__ VTYPE *)(op.xd);       \
    __ubuf__ VTYPE *xn = (__ubuf__ VTYPE *)(op.xn);       \
    VTYPE val = vBinaryS::GetScalar<VTYPE>(pc);           \
    builtin##_count<VTYPE, IsRhs>(xd, xn, val, op.count); \
  } while (0)


template <typename T>
__aicore_inline__ void BinCompare(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  using ResultT = typename std::conditional<sizeof(T) == 8, int32_t, T>::type;
#define CMP_DISPATCH(op_type, builtin)                                                        \
  case op_type:                                                                               \
    do {                                                                                      \
      __VEC_SCOPE__ {                                                                         \
        RegTensor<T> vreg0;                                                                   \
        RegTensor<T> vreg1;                                                                   \
        RegTensor<ResultT> vreg2;                                                             \
        RegTensor<ResultT> scalar0;                                                           \
        RegTensor<ResultT> scalar1;                                                           \
        vector_bool stPreg;                                                                   \
        uint32_t count = static_cast<uint32_t>(op.count);                                     \
        uint32_t sregLower = BlockNum(T);                                                     \
        uint16_t repeat = CeilDiv(count, sregLower);                                          \
        constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<ResultT>()>(); \
        vbr(scalar0, (ResultT)0);                                                             \
        vbr(scalar1, (ResultT)1);                                                             \
        for (uint16_t i = 0; i < repeat; ++i) {                                               \
          stPreg = UpdateMask<T>(count);                                                      \
          vector_bool cmp_mask;                                                               \
          if constexpr (sizeof(T) == 8) {                                                     \
            vlds((vector_2xvl_s64 &)vreg0, xn, i * sregLower);                                \
            vlds((vector_2xvl_s64 &)vreg1, xm, i * sregLower);                                \
            builtin(cmp_mask, (vector_2xvl_s64 &)vreg0, (vector_2xvl_s64 &)vreg1, stPreg);    \
          } else {                                                                            \
            vlds(vreg0, xn, i * sregLower, NORM);                                             \
            vlds(vreg1, xm, i * sregLower, NORM);                                             \
            builtin(cmp_mask, vreg0, vreg1, stPreg);                                          \
          }                                                                                   \
          vsel(vreg2, scalar1, scalar0, cmp_mask);                                            \
          vsts(vreg2, xd, i * sregLower, distValue, stPreg);                                  \
        }                                                                                     \
      }                                                                                       \
    } while (0);                                                                              \
    break
  vCompare op;
  vCompare::Decode(pc, head, op);
  __ubuf__ ResultT *xd = (__ubuf__ ResultT *)(op.xd);
  __ubuf__ T *xm = (__ubuf__ T *)(op.xm);
  __ubuf__ T *xn = (__ubuf__ T *)(op.xn);
  switch (op.type) {
    CMP_DISPATCH(V_CMP_EQ, vcmp_eq);
    CMP_DISPATCH(V_CMP_NE, vcmp_ne);
    CMP_DISPATCH(V_CMP_GT, vcmp_gt);
    CMP_DISPATCH(V_CMP_GE, vcmp_ge);
    CMP_DISPATCH(V_CMP_LT, vcmp_lt);
    CMP_DISPATCH(V_CMP_LE, vcmp_le);
    default:
      break;
  }
}

template <typename T>
__aicore_inline__ void BinCompareS(bcodeptr_t pc, uint64_t head, uint64_t tile) {
#define CMPS_DISPATCH(op_type, builtin)                                                 \
  case op_type:                                                                         \
    do {                                                                                \
      __VEC_SCOPE__ {                                                                   \
        RegTensor<T> vreg0;                                                             \
        RegTensor<T> vreg2;                                                             \
        RegTensor<T> scalar0;                                                           \
        RegTensor<T> scalar1;                                                           \
        vector_bool stPreg;                                                             \
        uint32_t count = static_cast<uint32_t>(op.count);                               \
        uint32_t sregLower = BlockNum(T);                                               \
        uint16_t repeat = CeilDiv(count, sregLower);                                    \
        constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>(); \
        vbr(scalar0, (T)0);                                                             \
        vbr(scalar1, (T)1);                                                             \
        for (uint16_t i = 0; i < repeat; ++i) {                                         \
          stPreg = UpdateMask<T>(count);                                                \
          vector_bool cmp_mask;                                                         \
          vlds(vreg0, xn, i * sregLower, NORM);                                         \
          builtin(cmp_mask, vreg0, val, stPreg);                                        \
          vsel(vreg2, scalar1, scalar0, cmp_mask);                                      \
          vsts(vreg2, xd, i * sregLower, distValue, stPreg);                            \
        }                                                                               \
      }                                                                                 \
    } while (0);                                                                        \
    break
  vCompareS op;
  vCompareS::Decode(pc, head, op);
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  __ubuf__ T *xn = (__ubuf__ T *)(op.xn);
  T val = vCompareS::GetScalar<T>(pc);
  switch (op.type) {
    CMPS_DISPATCH(V_CMP_EQ, vcmps_eq);
    CMPS_DISPATCH(V_CMP_NE, vcmps_ne);
    CMPS_DISPATCH(V_CMP_GT, vcmps_gt);
    CMPS_DISPATCH(V_CMP_GE, vcmps_ge);
    CMPS_DISPATCH(V_CMP_LT, vcmps_lt);
    CMPS_DISPATCH(V_CMP_LE, vcmps_le);
    default:
      break;
  }
}


template <vReduceOpType RED_TYPE, typename V>
__simd_callee__ __aicore_inline__ void BisectReduce(V &vreg2, V &vreg0, V &vreg1, vector_bool stPreg) {
  if constexpr (RED_TYPE == V_RED_SUM) {
    vadd(vreg2, vreg0, vreg1, stPreg, MODE_ZEROING);
  }
  if constexpr (RED_TYPE == V_RED_MAX) {
    vmax(vreg2, vreg0, vreg1, stPreg, MODE_ZEROING);
  }
  if constexpr (RED_TYPE == V_RED_MIN) {
    vmin(vreg2, vreg0, vreg1, stPreg, MODE_ZEROING);
  }
}

template <vReduceOpType RED_TYPE, typename T>
__aicore_inline__ void ReduceBisectLoop(__ubuf__ T *&xd, __ubuf__ T *&xn, uint64_t red_count, uint16_t dup_count,
                                        uint32_t dup_stride, uint32_t iter_size, __ubuf__ T *xd_base) {
  while (red_count > 1) {
    uint16_t iter_tail = red_count & 1ul;
    red_count >>= 1;
    uint32_t sregLower = BlockNum(T);
    uint32_t reduce_size = red_count * iter_size;
    constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();
    __VEC_SCOPE__ {
      RegTensor<T> vreg0;
      RegTensor<T> vreg1;
      RegTensor<T> vreg2;
      vector_bool stPreg;
      uint16_t repeat = CeilDiv(reduce_size, sregLower);
      uint16_t repeat_tail = CeilDiv(iter_size, sregLower);
      for (uint16_t i = 0; i < dup_count; i++) {
        uint32_t count = reduce_size;
        for (uint16_t j = 0; j < repeat; j++) {
          uint32_t offset = i * dup_stride + j * sregLower;
          stPreg = UpdateMask<T>(count);
          vlds(vreg0, xn, offset, NORM);
          vlds(vreg1, xn + reduce_size, offset, NORM);
          BisectReduce<RED_TYPE>(vreg2, vreg0, vreg1, stPreg);
          vsts(vreg2, xd, offset, distValue, stPreg);
        }
        mem_bar(VST_VLD);
        uint32_t count_tail = iter_size;
        for (uint16_t k = 0; k < iter_tail; k++) {
          for (uint16_t j = 0; j < repeat_tail; j++) {
            stPreg = UpdateMask<T>(count_tail);
            uint32_t offset = i * dup_stride + j * sregLower;
            vlds(vreg0, xd, offset, NORM);
            vlds(vreg1, xn + reduce_size * 2, offset, NORM);
            BisectReduce<RED_TYPE>(vreg2, vreg0, vreg1, stPreg);
            vsts(vreg2, xd, offset, distValue, stPreg);
          }
        }
      }
    }
    xn = xd = xd_base;
  }
}
template <typename T>
__aicore_inline__ void ElementAny(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vElementAny op;
  vElementAny::Decode(pc, head, op);
  if (IsLastTile(tile)) {
    op.repeat = op.repeat_tail;
  }
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  __ubuf__ T *xn = (__ubuf__ T *)(op.xn);
  ReduceBisectLoop<V_RED_MAX, T>(xd, xn, op.repeat, 1, 0, op.simd_width, (__ubuf__ T *)(op.xd));
  set_vector_mask(0, op.simd_width);
  SetVectorMask(op.simd_width);
  vcmax_mask(xd, xd, 1, 1, 1);
  set_flag(PIPE_V, PIPE_S, EVENT_ID0);
  wait_flag(PIPE_V, PIPE_S, EVENT_ID0);
  __ubuf__ uint32_t *result = (__ubuf__ uint32_t *)(op.xd);
  if (*result != 0) {
    vStoreCond::EncodeCond(pc + vElementAny::STORE_COND_OFFSET, 0, 1);
  }
}


template <typename T, typename G = UintFor<T>>
__aicore_inline__ void IsFinite(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vUnary op;
  vUnary::Decode(pc, head, op);
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  __ubuf__ G *xn = (__ubuf__ G *)(op.xn);
  __VEC_SCOPE__ {
    RegTensor<G> vreg0;
    RegTensor<T> vreg1;
    RegTensor<T> scalar_one;
    RegTensor<T> scalar_zero;
    vbr(scalar_zero, (T)0);
    vbr(scalar_one, (T)1);
    vector_bool cmp_mask;
    vector_bool stPreg;
    uint32_t count = op.count;
    uint32_t sregLower = BlockNum(G);
    uint16_t repeat = CeilDiv(count, sregLower);
    constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<G>()>();
    for (uint16_t i = 0; i < repeat; ++i) {
      stPreg = UpdateMask<G>(count);
      vlds(vreg0, xn, i * sregLower, NORM);
      vshls(vreg0, vreg0, 1, stPreg, MODE_ZEROING);
      if constexpr (std::is_same<T, float>::value) {
        vshrs(vreg0, vreg0, 24, stPreg, MODE_ZEROING);
        vcmps_eq(cmp_mask, vreg0, 255, stPreg);
      } else if constexpr (std::is_same<T, half>::value) {
        vshrs(vreg0, vreg0, 11, stPreg, MODE_ZEROING);
        vcmps_eq(cmp_mask, vreg0, 31, stPreg);
      } else if constexpr (std::is_same<T, bfloat16_t>::value) {
        vshrs(vreg0, vreg0, 8, stPreg, MODE_ZEROING);
        vcmps_eq(cmp_mask, vreg0, 11, stPreg);
      }
      vsel(vreg1, scalar_zero, scalar_one, cmp_mask);
      vsts(vreg1, xd, i * sregLower, distValue, stPreg);
    }
  }
}

__aicore_inline__ void Power(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vBinaryWS op;
  vBinaryWS::Decode(pc, head, op);
  __ubuf__ float *xm = (__ubuf__ float *)(op.xm);
  __ubuf__ float *xd = (__ubuf__ float *)(op.xd);
  __ubuf__ float *xn = (__ubuf__ float *)(op.xn);
  __VEC_SCOPE__ {
    RegTensor<float> vreg0;
    RegTensor<float> vreg1;
    RegTensor<float> vreg2;
    RegTensor<float> vreg3;
    RegTensor<float> vreg4;
    RegTensor<float> scalar_nan;
    RegTensor<float> scalar_one;
    vector_bool cmp_mask;
    vector_bool stPreg;
    uint32_t count = op.count;
    uint32_t sregLower = BlockNum(float);
    uint16_t repeat = CeilDiv(count, sregLower);
    constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<float>()>();
    vbr(scalar_nan, 0.0f / 0.0f);
    vbr(scalar_one, 1.0f);
    for (uint16_t i = 0; i < repeat; ++i) {
      stPreg = UpdateMask<float>(count);
      vlds(vreg0, xn, i * sregLower, NORM);
      vlds(vreg1, xm, i * sregLower, NORM);

      // x^y = e^{yln{abs{x}}}
      vabs(vreg2, vreg0, stPreg, MODE_ZEROING);
      vln(vreg2, vreg2, stPreg, MODE_ZEROING);
      vmul(vreg2, vreg2, vreg1, stPreg, MODE_ZEROING);
      vexp(vreg2, vreg2, stPreg, MODE_ZEROING);

      // Check 0^0
      vcmps_eq(cmp_mask, vreg1, (float)0, stPreg);
      vsel(vreg2, scalar_one, vreg2, cmp_mask);

      // Constructing the odd-even case
      vmuls(vreg4, vreg1, (float)0.5, stPreg, MODE_ZEROING);
      Truncate<float, RoundMode::CAST_FLOOR>(vreg4, vreg4, stPreg);
      vmuls(vreg4, vreg4, (float)2.0, stPreg, MODE_ZEROING);
      vsub(vreg4, vreg1, vreg4, stPreg, MODE_ZEROING);
      vcmps_eq(cmp_mask, vreg4, (float)0, stPreg);
      vneg(vreg3, vreg2, stPreg, MODE_ZEROING);
      vsel(vreg4, vreg2, vreg3, cmp_mask);

      // Check negative^{decimal}
      Truncate<float, RoundMode::CAST_TRUNC>(vreg3, vreg1, stPreg);
      vcmp_eq(cmp_mask, vreg3, vreg1, stPreg);
      vsel(vreg4, vreg4, scalar_nan, cmp_mask);

      vcmps_lt(cmp_mask, vreg0, (float)0, stPreg);
      vsel(vreg2, vreg4, vreg2, cmp_mask);

      vsts(vreg2, xd, i * sregLower, distValue, stPreg);
    }
  }
}

template <typename T>
__aicore_inline__ void BroadcastS(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  using Op = typename std::conditional<sizeof(T) == 8, vBroadcastS_B64, vBroadcastS>::type;
  Op op;
  Op::Decode(pc, head, op);
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  T val;
  if constexpr (sizeof(T) == 8) {
    val = static_cast<T>((op.high << 32) | op.scalar);
  } else {
    val = op.scalar;
  }
  VectorDupCount(xd, val, op.count);
}

template <typename T>
__aicore_inline__ void ExpandBroadcastX(__ubuf__ T *xd, const vBroadcastX &op) {
  uint32_t block_size = 32 / sizeof(T);
  uint32_t count_blocks = static_cast<uint32_t>(op.count) / block_size;
  for (uint16_t k = 0; k < (uint16_t)op.iter_num; k++) {
    __ubuf__ T *row = xd + k * op.count * op.lead_num;
    uint32_t copied_blocks = sizeof(T) == 8 ? 16 : 8;
    while ((copied_blocks << 1) <= count_blocks) {
      copy_ubuf_to_ubuf(row + copied_blocks * block_size, row, 0, op.lead_num, copied_blocks,
                        count_blocks - copied_blocks, count_blocks - copied_blocks);
      copied_blocks <<= 1;
    }
    if (copied_blocks < count_blocks) {
      uint32_t tail_blocks = count_blocks - copied_blocks;
      copy_ubuf_to_ubuf(row + copied_blocks * block_size, row, 0, op.lead_num, tail_blocks,
                        count_blocks - tail_blocks, count_blocks - tail_blocks);
    }
  }
}

template <typename T>
__aicore_inline__ void BroadcastX(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vBroadcastX op;
  vBroadcastX::Decode(pc, head, op);
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  __ubuf__ T *xn = (__ubuf__ T *)(op.xn);
  __VEC_SCOPE__ {
    RegTensor<T> vreg0;
    uint32_t sregLower = BlockNum(T);
    uint32_t max_block = min(sregLower, static_cast<uint32_t>(op.count));
    vector_bool stPreg = UpdateMask<T>(max_block);
    constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();
    for (uint16_t k = 0; k < (uint16_t)op.iter_num; k++) {
      for (uint16_t i = 0; i < (uint16_t)op.lead_num; i++) {
        uint32_t xn_offset = k * (op.lead_num + op.lead_pad) + i;
        if constexpr (sizeof(T) == 8) {
          __ubuf__ int32_t *xn_b32 = (__ubuf__ int32_t *)(xn);
          vlds((RegTensor<int32_t> &)vreg0.reg[0], xn_b32, xn_offset * 2, BRC_B32);
          vlds((RegTensor<int32_t> &)vreg0.reg[1], xn_b32, xn_offset * 2 + 1, BRC_B32);
        } else if constexpr (sizeof(T) == 4) {
          vlds(vreg0, xn, xn_offset, BRC_B32);
        } else if constexpr (sizeof(T) == 2) {
          vlds(vreg0, xn, xn_offset, BRC_B16);
        } else {
          vlds(vreg0, xn, xn_offset, BRC_B8);
        }
        uint32_t xd_offset = k * op.count * op.lead_num + i * op.count;
        if constexpr (sizeof(T) == 8) {
          vsts((vector_2xvl_s64 &)vreg0, xd, xd_offset, stPreg);
        } else {
          vsts(vreg0, xd, xd_offset, distValue, stPreg);
        }
      }
    }
  }

  if (op.count > BlockNum(T)) {
    ExpandBroadcastX(xd, op);
  }
}

__aicore_inline__ void BroadcastY(bcodeptr_t pc, uint64_t head) {
  vBroadcastY op;
  vBroadcastY::Decode(pc, head, op);
  __ubuf__ uint8_t *xd = (__ubuf__ uint8_t *)(op.xd);
  __ubuf__ uint8_t *xn = (__ubuf__ uint8_t *)(op.xn);
  uint64_t dst_rs = op.dup_num * op.dup_stride;
  uint64_t block_size = 1;
  uint64_t lenburst = op.dup_stride;
  copy_ubuf_to_ubuf(xd, xn, 0, op.iter_num, lenburst, 0, dst_rs - lenburst);
  while ((block_size << 1) <= op.dup_num) {
    copy_ubuf_to_ubuf(xd + (lenburst << 5), xd, 0, op.iter_num, lenburst, dst_rs - lenburst, dst_rs - lenburst);
    block_size <<= 1;
    lenburst <<= 1;
  }
  if (op.dup_num > block_size) {
    lenburst = (op.dup_num - block_size) * op.dup_stride;
    copy_ubuf_to_ubuf(xd + (block_size * op.dup_stride << 5), xd, 0, op.iter_num, lenburst, dst_rs - lenburst,
                      dst_rs - lenburst);
  }
}

template <vReduceOpType RED_TYPE, typename T>
__simd_callee__ __aicore_inline__ void ReduceLoop(RegTensor<T> &accum, RegTensor<T> &value, __ubuf__ T *xn,
                                               uint32_t offset, uint16_t load_count, uint32_t load_stride,
                                               vector_bool mask) {
  vlds(accum, xn, offset, NORM);
  for (uint16_t r = 1; r < load_count; ++r) {
    vlds(value, xn, offset + r * load_stride, NORM);
    BisectReduce<RED_TYPE>(accum, accum, value, mask);
  }
}

template <vReduceOpType RED_TYPE, typename T>
__simd_callee__ __aicore_inline__ void ReduceLoop4(RegTensor<T> &accum, RegTensor<T> &value, __ubuf__ T *xn,
                                                uint32_t offset, uint16_t block_count, uint16_t tail_count,
                                                uint32_t load_stride, vector_bool mask) {
  RegTensor<T> accum1, accum2, accum3;
  vlds(accum, xn, offset, NORM);
  vlds(accum1, xn, offset + load_stride, NORM);
  vlds(accum2, xn, offset + 2 * load_stride, NORM);
  vlds(accum3, xn, offset + 3 * load_stride, NORM);
  for (uint16_t r = 1; r < block_count; ++r) {
    vlds(value, xn, offset + 4 * r * load_stride, NORM);
    BisectReduce<RED_TYPE>(accum, accum, value, mask);
    vlds(value, xn, offset + (4 * r + 1) * load_stride, NORM);
    BisectReduce<RED_TYPE>(accum1, accum1, value, mask);
    vlds(value, xn, offset + (4 * r + 2) * load_stride, NORM);
    BisectReduce<RED_TYPE>(accum2, accum2, value, mask);
    vlds(value, xn, offset + (4 * r + 3) * load_stride, NORM);
    BisectReduce<RED_TYPE>(accum3, accum3, value, mask);
  }
  for (uint16_t r = 0; r < tail_count; ++r) {
    vlds(value, xn, offset + (4 * block_count + r) * load_stride, NORM);
    BisectReduce<RED_TYPE>(accum, accum, value, mask);
  }
  BisectReduce<RED_TYPE>(accum, accum, accum2, mask);
  BisectReduce<RED_TYPE>(accum1, accum1, accum3, mask);
  BisectReduce<RED_TYPE>(accum, accum, accum1, mask);
}

enum class ReduceLoad { Single, Loop, Loop4 };

template <ReduceLoad LOAD, vReduceOpType RED_TYPE, typename T>
__aicore_inline__ void ReduceXLoop(__ubuf__ T *xd, __ubuf__ T *xn, const vReduceX &op, uint16_t has_tail) {
  constexpr uint32_t vector_lanes = BlockNum(T);
  const uint16_t load_count = op.red_size / vector_lanes;
  const uint16_t block_count = load_count >> 2;
  const uint16_t tail_count = load_count & 3;
  const uint32_t tail_lanes = op.red_size % vector_lanes;
  const uint32_t dst_stride = op.dup_block + op.dup_pad;
  const uint32_t src_stride = op.red_size * op.dup_block;
  const uint16_t iter_count = op.dup_size / op.dup_block;
  __VEC_SCOPE__ {
    RegTensor<T> accum, value;
    uint32_t mask_count = min((uint32_t)op.red_size, vector_lanes);
    vector_bool mask = UpdateMask<T>(mask_count);
    uint32_t tail_remaining = tail_lanes;
    vector_bool tail_mask = UpdateMask<T>(tail_remaining);
    constexpr auto distValue = std::integral_constant<DistVST, sizeof(T) == 2 ? DistVST::DIST_ONEPT_B16
                                                                          : DistVST::DIST_ONEPT_B32>();
    for (uint16_t k = 0; k < iter_count; ++k) {
      for (uint16_t i = 0; i < (uint16_t)op.dup_block; ++i) {
        uint32_t offset = k * src_stride + i * op.red_size;
        if constexpr (LOAD == ReduceLoad::Single) {
          vlds(accum, xn, offset, NORM);
        } else if constexpr (LOAD == ReduceLoad::Loop) {
          ReduceLoop<RED_TYPE>(accum, value, xn, offset, load_count, vector_lanes, mask);
        } else {
          ReduceLoop4<RED_TYPE>(accum, value, xn, offset, block_count, tail_count, vector_lanes, mask);
        }
        for (uint16_t tail = 0; tail < has_tail; ++tail) {
          vlds(value, xn, offset + load_count * vector_lanes, NORM);
          BisectReduce<RED_TYPE>(value, accum, value, tail_mask);
          vsel(accum, value, accum, tail_mask);
        }
        if constexpr (RED_TYPE == V_RED_SUM) {
          vcadd(value, accum, mask, MODE_ZEROING);
        }
        if constexpr (RED_TYPE == V_RED_MAX) {
          vcmax(value, accum, mask, MODE_ZEROING);
        }
        if constexpr (RED_TYPE == V_RED_MIN) {
          vcmin(value, accum, mask, MODE_ZEROING);
        }
        vsts(value, xd, k * dst_stride + i, distValue, mask);
      }
    }
  }
}

template <uint16_t GROUP_COUNT, vReduceOpType RED_TYPE, typename T>
__simd_callee__ __aicore_inline__ void ReduceXFoldGroups(RegTensor<T> &accum, RegTensor<T> &value,
                                                       vector_bool mask) {
  if constexpr (GROUP_COUNT > 1) {
    if constexpr (RED_TYPE == V_RED_SUM) {
      vcpadd(accum, accum, mask, MODE_ZEROING);
    } else {
      vdintlv(accum, value, accum, accum);
      BisectReduce<RED_TYPE>(accum, accum, value, mask);
    }
    ReduceXFoldGroups<GROUP_COUNT / 2, RED_TYPE, T>(accum, value, mask);
  }
}

// Reduce each 32-byte group, then combine the groups belonging to the same row.
template <uint16_t ROW_BYTES, vReduceOpType RED_TYPE, typename T>
__aicore_inline__ void ReduceXGroup(__ubuf__ T *xd, __ubuf__ T *xn, const vReduceX &op) {
  constexpr uint32_t row_size = ROW_BYTES / sizeof(T);
  constexpr uint32_t vector_lanes = BlockNum(T);
  constexpr uint32_t rows_per_vector = vector_lanes / row_size;
  const uint16_t repeats = CeilDiv((uint32_t)op.dup_block, rows_per_vector);
  const uint16_t iter_count = op.dup_size / op.dup_block;
  const uint32_t dst_stride = op.dup_block + op.dup_pad;
  const uint32_t src_stride = row_size * op.dup_block;
  __VEC_SCOPE__ {
    RegTensor<T> accum, value;
    vector_bool mask = CreateMask<T>();
    vector_align align;
    for (uint16_t k = 0; k < iter_count; ++k) {
      __ubuf__ T *dst = xd + k * dst_stride;
      uint32_t remaining = op.dup_block;
      for (uint16_t i = 0; i < repeats; ++i) {
        uint32_t count = min(remaining, rows_per_vector);
        remaining -= count;
        vlds(accum, xn, k * src_stride + i * vector_lanes, NORM);
        if constexpr (RED_TYPE == V_RED_SUM) {
          vcgadd(accum, accum, mask, MODE_ZEROING);
        }
        if constexpr (RED_TYPE == V_RED_MAX) {
          vcgmax(accum, accum, mask, MODE_ZEROING);
        }
        if constexpr (RED_TYPE == V_RED_MIN) {
          vcgmin(accum, accum, mask, MODE_ZEROING);
        }
        ReduceXFoldGroups<ROW_BYTES / 32, RED_TYPE, T>(accum, value, mask);
        vstus(align, count, accum, dst, POST_UPDATE);
      }
      vstas(align, dst, 0, POST_UPDATE);
    }
  }
}

// Specialize the load loop before entering the VF.
template <vReduceOpType RED_TYPE, typename T>
__aicore_inline__ void ReduceXDispatch(__ubuf__ T *xd, __ubuf__ T *xn, const vReduceX &op, uint16_t has_tail) {
  const uint16_t load_count = op.red_size / BlockNum(T);
  if (load_count < 2) {
    ReduceXLoop<ReduceLoad::Single, RED_TYPE>(xd, xn, op, has_tail);
  } else if (load_count < 4) {
    ReduceXLoop<ReduceLoad::Loop, RED_TYPE>(xd, xn, op, has_tail);
  } else {
    ReduceXLoop<ReduceLoad::Loop4, RED_TYPE>(xd, xn, op, has_tail);
  }
}

template <vReduceOpType RED_TYPE, typename T>
__aicore_inline__ void ReduceXImpl(__ubuf__ T *xd, __ubuf__ T *xn, const vReduceX &op) {
  switch (op.red_size * sizeof(T)) {
    case 32:
      ReduceXGroup<32, RED_TYPE>(xd, xn, op);
      return;
    case 64:
      ReduceXGroup<64, RED_TYPE>(xd, xn, op);
      return;
    case 128:
      if constexpr (sizeof(T) == 2) {
        ReduceXGroup<128, RED_TYPE>(xd, xn, op);
        return;
      }
      break;
  }
  if (op.red_size > BlockNum(T) && op.red_size % BlockNum(T) != 0) {
    ReduceXDispatch<RED_TYPE>(xd, xn, op, 1);
  } else {
    ReduceXDispatch<RED_TYPE>(xd, xn, op, 0);
  }
}

template <vReduceOpType RED_TYPE, typename T>
__aicore_inline__ void ReduceX(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vReduceX op;
  vReduceX::Decode(pc, head, op);
  vReduceX::DecodeBlock(pc, op);
  if (IsLastTile(tile)) {
    op.red_size = op.red_tail;
  }
  __ubuf__ T *xn = (__ubuf__ T *)(op.xn);
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  ReduceXImpl<RED_TYPE>(xd, xn, op);
}

template <uint16_t SHIFT, uint16_t ROW_SIZE, vReduceOpType RED_TYPE, typename T>
__simd_callee__ __aicore_inline__ void FoldPackedRows(RegTensor<T> &accum, RegTensor<T> &value) {
  if constexpr (SHIFT >= ROW_SIZE) {
    using IndexT = typename std::conditional<sizeof(T) == 4, int32_t, int16_t>::type;
    RegTensor<IndexT> index;
    vci(index, (IndexT)SHIFT, INC_ORDER);
    // Merge the upper half of the row slots into the lower half, keeping columns aligned.
    vselr((RegTensor<UintFor<T>> &)value, (RegTensor<UintFor<T>> &)accum, (RegTensor<UintFor<T>> &)index);
    uint32_t mask_count = SHIFT;
    vector_bool mask = UpdateMask<T>(mask_count);
    BisectReduce<RED_TYPE>(accum, accum, value, mask);
    FoldPackedRows<SHIFT / 2, ROW_SIZE, RED_TYPE, T>(accum, value);
  }
}

template <ReduceLoad LOAD, vReduceOpType RED_TYPE, typename T>
__aicore_inline__ void ReduceYRows(__ubuf__ T *xd, __ubuf__ T *xn, uint16_t red_count, uint16_t dup_count,
                                 uint32_t row_size) {
  constexpr uint32_t vector_lanes = BlockNum(T);
  const uint16_t output_vectors = CeilDiv(row_size, vector_lanes);
  const uint32_t group_stride = row_size * red_count;
  constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();
  const uint16_t block_count = red_count >> 2;
  const uint16_t tail_count = red_count & 3;
  __VEC_SCOPE__ {
    RegTensor<T> accum, value;
    for (uint16_t i = 0; i < dup_count; ++i) {
      uint32_t remaining = row_size;
      for (uint16_t j = 0; j < output_vectors; ++j) {
        vector_bool reduce_mask = UpdateMask<T>(remaining);
        uint32_t offset = i * group_stride + j * vector_lanes;
        if constexpr (LOAD == ReduceLoad::Loop) {
          ReduceLoop<RED_TYPE>(accum, value, xn, offset, red_count, row_size, reduce_mask);
        } else {
          ReduceLoop4<RED_TYPE>(accum, value, xn, offset, block_count, tail_count, row_size, reduce_mask);
        }
        vsts(accum, xd, i * row_size + j * vector_lanes, distValue, reduce_mask);
      }
    }
  }
}

// Pack consecutive rows into each vector, then fold the row slots in registers.
// Requires a power-of-two row width and at least one complete input vector per group.
template <ReduceLoad LOAD, uint16_t ROW_SIZE, vReduceOpType RED_TYPE, typename T>
__aicore_inline__ void ReduceYPack(__ubuf__ T *xd, __ubuf__ T *xn, uint16_t red_count, uint16_t dup_count) {
  constexpr uint32_t vector_lanes = BlockNum(T);
  const uint32_t group_stride = (uint32_t)ROW_SIZE * red_count;
  const uint16_t load_count = group_stride / vector_lanes;
  const uint16_t tail_lanes = group_stride & (vector_lanes - 1);
  const uint16_t tail_vector_count = tail_lanes != 0;
  constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();
  const uint16_t block_count = load_count >> 2;
  const uint16_t tail_count = load_count & 3;
  __VEC_SCOPE__ {
    RegTensor<T> accum, value;
    vector_bool reduce_mask = CreateMask<T>();
    uint32_t tail_remaining = tail_lanes;
    vector_bool tail_mask = UpdateMask<T>(tail_remaining);
    uint32_t store_count = ROW_SIZE;
    vector_bool store_mask = UpdateMask<T>(store_count);
    for (uint16_t i = 0; i < dup_count; ++i) {
      uint32_t offset = i * group_stride;
      if constexpr (LOAD == ReduceLoad::Loop) {
        ReduceLoop<RED_TYPE>(accum, value, xn, offset, load_count, vector_lanes, reduce_mask);
      } else {
        ReduceLoop4<RED_TYPE>(accum, value, xn, offset, block_count, tail_count, vector_lanes, reduce_mask);
      }
      for (uint16_t r = 0; r < tail_vector_count; ++r) {
        vlds(value, xn, offset + (uint32_t)load_count * vector_lanes, NORM);
        BisectReduce<RED_TYPE>(value, accum, value, tail_mask);
        vsel(accum, value, accum, tail_mask);
      }
      FoldPackedRows<vector_lanes / 2, ROW_SIZE, RED_TYPE, T>(accum, value);
      vsts(accum, xd, (uint32_t)i * ROW_SIZE, distValue, store_mask);
    }
  }
}

template <uint16_t ROW_SIZE, vReduceOpType RED_TYPE, typename T>
__aicore_inline__ void ReduceYPackDispatch(__ubuf__ T *xd, __ubuf__ T *xn, uint16_t red_count, uint16_t dup_count) {
  if ((uint32_t)ROW_SIZE * red_count / BlockNum(T) < 4) {
    ReduceYPack<ReduceLoad::Loop, ROW_SIZE, RED_TYPE>(xd, xn, red_count, dup_count);
  } else {
    ReduceYPack<ReduceLoad::Loop4, ROW_SIZE, RED_TYPE>(xd, xn, red_count, dup_count);
  }
}

template <vReduceOpType RED_TYPE, typename T>
__aicore_inline__ void ReduceYLoop(__ubuf__ T *xd, __ubuf__ T *xn, uint16_t red_count, uint16_t dup_count,
                                 uint32_t iter_size) {
  // Initialize from a complete vector; one to three vectors use the single-accumulator loop.
  if ((uint32_t)red_count * iter_size >= BlockNum(T)) {
    switch (iter_size) {
      case 8:
        ReduceYPackDispatch<8, RED_TYPE>(xd, xn, red_count, dup_count);
        return;
      case 16:
        ReduceYPackDispatch<16, RED_TYPE>(xd, xn, red_count, dup_count);
        return;
      case 32:
        ReduceYPackDispatch<32, RED_TYPE>(xd, xn, red_count, dup_count);
        return;
      case 64:
        ReduceYPackDispatch<64, RED_TYPE>(xd, xn, red_count, dup_count);
        return;
    }
  }
  if (red_count < 4) {
    ReduceYRows<ReduceLoad::Loop, RED_TYPE>(xd, xn, red_count, dup_count, iter_size);
  } else {
    ReduceYRows<ReduceLoad::Loop4, RED_TYPE>(xd, xn, red_count, dup_count, iter_size);
  }
}

template <vReduceOpType RED_TYPE, typename T>
__aicore_inline__ void ReduceY(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vReduceY op;
  vReduceY::Decode(pc, head, op);
  __ubuf__ T *xn = (__ubuf__ T *)(op.xn);
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  uint64_t red_size = IsLastTile(tile) ? op.red_tail : op.red_size;
  if (red_size == 1) {
    uint64_t lenburst = op.dup_num * op.iter_size >> BlockDataShift(T);
    copy_ubuf_to_ubuf(xd, xn, 0, 1, lenburst, 0, 0);
    return;
  }
  ReduceYLoop<RED_TYPE>(xd, xn, red_size, op.dup_num, op.iter_size);
}

__aicore_inline__ void ReduceJoinAddBatch(__ubuf__ float *xd, __ubuf__ float *xs, uint32_t count,
                                        uint32_t stride, uint16_t rows, uint16_t core_begin, uint16_t thread_idx) {
  const uint16_t repeat = CeilDiv<uint32_t>(count, BlockNum(float));
  // Split around the local row before entering VF; it is already in xd.
  const uint16_t before = thread_idx >= core_begin && thread_idx < core_begin + rows ? thread_idx - core_begin : rows;
  const uint16_t after = before + (before < rows);
  __VEC_SCOPE__ {
    RegTensor<float> accum, value;
    for (uint16_t i = 0; i < repeat; ++i) {
      vector_bool mask = UpdateMask<float>(count);
      uint32_t offset = i * BlockNum(float);
      vlds(accum, xd, offset, NORM);
      for (uint16_t r = 0; r < before; ++r) {
        vlds(value, xs, r * stride + offset, NORM);
        vadd(accum, accum, value, mask, MODE_ZEROING);
      }
      for (uint16_t r = after; r < rows; ++r) {
        vlds(value, xs, r * stride + offset, NORM);
        vadd(accum, accum, value, mask, MODE_ZEROING);
      }
      vsts(accum, xd, offset, NORM_B32, mask);
    }
  }
}

// Keep cross-core register saves/restores out of the per-tile ReduceJoin path;
// inlining increases scalar overhead even on tiles that do not merge across cores.
__aicore_inline__ void _ReduceJoinCrossCore(bcodeptr_t pc, uint64_t head, uint32_t thread_size) {
  vReduceJoin op;
  vReduceJoin::Decode(pc, head, op);
  uint64_t iter_total = op.iter_num * op.iter_stride;
  uint64_t lenburst = (iter_total + 7) >> BlockDataShift(float);
  uint64_t blockidx = vBlockIdx();
  uint64_t ws_stride = lenburst * 32;
  set_flag(PIPE_V, PIPE_MTE3, EVENT_ID7);
  wait_flag(PIPE_V, PIPE_MTE3, EVENT_ID7);
  copy_ubuf_to_gm_align_v2((__gm__ uint8_t *)op.ws + blockidx * ws_stride, (__ubuf__ void *)op.xd, 0, 1,
                           iter_total * sizeof(float), 0, 0, 0);
  uint64_t iter_offset, iter_range, join_offset, join_count;
  uint64_t thread_idx = blockidx % thread_size;
  constexpr uint64_t flag_id = 0;
  uint64_t sync_flag = vFftsSyncConfig(0, flag_id);
  // Batched reads include this core, so every workspace store must finish.
  ffts_cross_core_sync(PIPE_MTE3, sync_flag);
  if (op.iter_num == 1) {
    join_count = ((iter_total - 1) / thread_size + 64) & ~0x3ful;
    join_offset = join_count * thread_idx;
    if (join_offset >= iter_total) {
      join_count = 0;
    } else if (join_offset + join_count > iter_total) {
      join_count = iter_total - join_offset;
    }
    iter_offset = join_offset;
    iter_range = join_count;
  } else {
    iter_range = (op.iter_num - 1) / thread_size + 1;
    iter_offset = iter_range * thread_idx;
    if (iter_offset >= op.iter_num) {
      iter_range = 0;
    } else if (iter_offset + iter_range > op.iter_num) {
      iter_range = op.iter_num - iter_offset;
    }
    join_offset = iter_offset * op.iter_stride;
    join_count = iter_range * op.iter_stride;
  }
  vStoreCond::EncodeCond(pc + vReduceJoin::STORE_COND_OFFSET, iter_offset, iter_range);
  if (join_offset >= iter_total) {
    wait_flag_dev(PIPE_MTE2, flag_id);
    return;
  }
  op.xd += join_offset * sizeof(float);
  op.ws += join_offset * sizeof(float);
  const uint64_t slice_bytes = join_count * sizeof(float);
  const uint64_t ub_stride = (slice_bytes + 31) & ~31ul;
  const bool use_batch = op.capacity >= 2 * ub_stride;
  const uint64_t group_base = blockidx - thread_idx;
  uint64_t ping = 0;
  set_flag(PIPE_V, PIPE_MTE2, EVENT_ID6);
  set_flag(PIPE_V, PIPE_MTE2, EVENT_ID7);
  wait_flag_dev(PIPE_MTE2, flag_id);
  if (!use_batch) {
    for (uint64_t i = 0; i < thread_size; ++i) {
      if (i == thread_idx) continue;
      uint64_t xs = ping ? op.xn : op.xs;
      event_t event = event_t(EVENT_ID6 ^ ping);
      wait_flag(PIPE_V, PIPE_MTE2, event);
      copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t *)xs, (__gm__ uint8_t *)op.ws + (group_base + i) * ws_stride,
                               0, 1, slice_bytes, 0, 0, false, 0, 0, 0);
      set_flag(PIPE_MTE2, PIPE_V, event);
      wait_flag(PIPE_MTE2, PIPE_V, event);
      vadd_count((__ubuf__ float *)op.xd, (__ubuf__ float *)op.xd, (__ubuf__ float *)xs, join_count);
      set_flag(PIPE_V, PIPE_MTE2, event);
      ping ^= 1;
    }
  } else {
    const uint64_t batch_max = op.capacity / ub_stride;
    // thread_size is at most 127 (V_RED_HEAD_THREAD_MASK), within the DMA burst limit.
    for (uint64_t core_begin = 0; core_begin < thread_size; core_begin += batch_max) {
      const uint64_t remaining = thread_size - core_begin;
      const uint64_t batch_count = batch_max < remaining ? batch_max : remaining;
      uint64_t xs = ping ? op.xn : op.xs;
      event_t event = event_t(EVENT_ID6 ^ ping);
      wait_flag(PIPE_V, PIPE_MTE2, event);
      copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t *)xs,
                               (__gm__ uint8_t *)op.ws + (group_base + core_begin) * ws_stride,
                               0, batch_count, slice_bytes, 0, 0, false, 0, ws_stride, ub_stride);
      set_flag(PIPE_MTE2, PIPE_V, event);
      wait_flag(PIPE_MTE2, PIPE_V, event);
      ReduceJoinAddBatch((__ubuf__ float *)op.xd, (__ubuf__ float *)xs, join_count,
                         ub_stride / sizeof(float), batch_count, core_begin, thread_idx);
      set_flag(PIPE_V, PIPE_MTE2, event);
      ping ^= 1;
    }
  }
  wait_flag(PIPE_V, PIPE_MTE2, EVENT_ID6);
  wait_flag(PIPE_V, PIPE_MTE2, EVENT_ID7);
}

template <typename... Args>
__aicore__ __attribute__((noinline)) void ReduceJoinCrossCore(Args... args);

__aicore_inline__ void ReduceJoin(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vReduceJoin op;
  vReduceJoin::Decode(pc, head, op);
  uint32_t red_head = *reinterpret_cast<__bcode__ uint32_t *>(pc + op.seg_tile_rel);
  uint64_t iter_total = op.iter_num * op.iter_stride;
  uint64_t lenburst = (iter_total + 7) >> BlockDataShift(float);
  // RESTRICT: tile in segement is continuously
  if (IsBeginTile(tile) && !(red_head >> V_RED_HEAD_INC_FLAG_OFFSET)) {
    copy_ubuf_to_ubuf((__ubuf__ void *)op.xd, (__ubuf__ void *)op.xn, 0, 1, lenburst, 0, 0);
  } else {
    vadd_count((__ubuf__ float *)op.xd, (__ubuf__ float *)op.xd, (__ubuf__ float *)op.xn, iter_total);
  }
  uint32_t loop_repeat = (red_head >> V_RED_HEAD_REPEAT_OFFSET) & V_RED_HEAD_REPEAT_MASK;
  if (!IsEndTile(tile) || loop_repeat > 0) {
    return;
  }
  uint32_t thread_size = (red_head >> V_RED_HEAD_THREAD_OFFSET) & V_RED_HEAD_THREAD_MASK;
  if (thread_size == 1) {
    vStoreCond::EncodeCond(pc + vReduceJoin::STORE_COND_OFFSET, 0, op.iter_num > 1 ? op.iter_num : op.iter_stride);
    return;
  }
  ReduceJoinCrossCore(pc, head, thread_size);
}

template <typename T>
__aicore_inline__ void Select(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  using CondT = typename std::conditional<sizeof(T) == 8, int32_t, T>::type;
  vSelect op;
  vSelect::Decode(pc, head, op);
  __ubuf__ T *xm = (__ubuf__ T *)(op.xm);
  __ubuf__ CondT *cond = (__ubuf__ CondT *)(op.cond);
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  __ubuf__ T *xn = (__ubuf__ T *)(op.xn);
  __VEC_SCOPE__ {
    RegTensor<T> vreg0;
    RegTensor<T> vreg1;
    RegTensor<CondT> vreg2;
    RegTensor<T> vreg3;
    vector_bool stPreg;
    uint32_t count = static_cast<uint32_t>(op.count);
    uint32_t sregLower = BlockNum(T);
    uint16_t repeat = CeilDiv(count, sregLower);
    constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();
    for (uint16_t i = 0; i < repeat; ++i) {
      stPreg = UpdateMask<T>(count);
      vector_bool cmp_mask;
      if constexpr (sizeof(T) == 8) {
        vlds((vector_2xvl_s64 &)vreg0, xn, i * sregLower);
        vlds((vector_2xvl_s64 &)vreg1, xm, i * sregLower);
      } else {
        vlds(vreg0, xn, i * sregLower, NORM);
        vlds(vreg1, xm, i * sregLower, NORM);
      }
      vlds(vreg2, cond, i * sregLower, NORM);
      vcmps_ne(cmp_mask, vreg2, CondT(0), stPreg);
      if constexpr (sizeof(T) == 8) {
        vsel((vector_2xvl_s64 &)vreg3, (vector_2xvl_s64 &)vreg0, (vector_2xvl_s64 &)vreg1, cmp_mask);
        vsts((vector_2xvl_s64 &)vreg3, xd, i * sregLower, stPreg);
      } else {
        vsel(vreg3, vreg0, vreg1, cmp_mask);
        vsts(vreg3, xd, i * sregLower, distValue, stPreg);
      }
    }
  }
}

__aicore_inline__ void Copy(bcodeptr_t pc, uint64_t head) {
  vCopy op;
  vCopy::Decode(pc, head, op);
  copy_ubuf_to_ubuf((__ubuf__ void *)op.xd, (__ubuf__ void *)op.xn, 0, 1, op.lenburst, 0, 0);
}

__aicore_inline__ void CopyCubeTile(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vCubeCopy op;
  vCubeCopy::Decode(pc, head, op);
  uint64_t tile_idx = TileIdx(tile);
  if (op.tile_offset > 0) tile_idx -= get_subblockid() * op.tile_offset;
  uint64_t src = op.xn + tile_idx * (op.lenburst << 5);
  uint64_t lenburst = min(op.lenburst, (static_cast<uint64_t>(get_shmem_sz())- src) >> 5);
  copy_ubuf_to_ubuf((__ubuf__ uint8_t *)op.xd, (__ubuf__ void *)src, 0, 1, lenburst, 0, 0);
}

template <typename T>
__aicore_inline__ void ClearPad(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vClearPad op;
  vClearPad::Decode(pc, head, op);
  if (IsLastTile(tile) && op.iter_tail) {
    op.iter_size = op.iter_tail;
    op.iter_stride = op.iter_tail + op.simd_width - (op.iter_tail % op.simd_width);
  }
  if (op.iter_size == op.iter_stride) {
    return;
  }
  uint64_t simd_valid = op.iter_size - (op.iter_stride - op.simd_width);
  SetInvalidMask<T>(op.simd_width, simd_valid);
  __ubuf__ T *fill = (__ubuf__ T *)(op.xd) + op.iter_size - simd_valid;
  VectorDupMask<T>(fill, op.scalar, op.iter_num, op.iter_stride);
}

template <typename T>
__aicore_inline__ void AtomicCum(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vAtomicCum op;
  vAtomicCum::Decode(pc, head, op);
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  __ubuf__ T *xn = (__ubuf__ T *)(op.xn);
  uint64_t tile_idx = TileIdx(tile);
  if (op.round_rank) {
    tile_idx = RoundUpTileIdx<kRoundCacheLoad>(tile, tile_idx, op.round_rank, pc + vAtomicCum::ROUND_OFFSET);
    if (tile_idx == INVALID_INT) {
      if (op.red_op == V_RED_SUM) {
        vadd_count(xd, xd, xn, op.count);
      } else if (op.red_op == V_RED_MAX) {
        vmax_count(xd, xd, xn, op.count);
      } else if (op.red_op == V_RED_MIN) {
        vmin_count(xd, xd, xn, op.count);
      }
      return;
    }
  }
  copy_ubuf_to_ubuf((__ubuf__ void *)op.xd, (__ubuf__ void *)op.xn, 0, 1, op.count >> BlockDataShift(T), 0, 0);
}

template <typename T>
__aicore_inline__ void OneHot(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vOneHot op;
  vOneHot::Decode(pc, op);
  __ubuf__ int32_t *indices = (__ubuf__ int32_t *)(op.xn);
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  T on_value, off_value;
  vOneHot::DecodeValue(pc, on_value, off_value);
  VectorDupCount<T>(xd, off_value, op.data_size);
  switch (op.mode) {
    case vOneHot::MODE_X: {
      VfCall<OneHotSimtX<T>>(cce::dim3(kSimtThreadNum), xd, indices, static_cast<uint32_t>(op.iter_num),
                             static_cast<uint32_t>(op.depth), on_value);
      break;
    }
    case vOneHot::MODE_X_TILE: {
      uint32_t begin = static_cast<uint32_t>((TileIdx(tile) % op.dup_round) * op.depth);
      VfCall<OneHotSimtXTile<T>>(cce::dim3(kSimtThreadNum), xd, indices, begin, static_cast<uint32_t>(op.depth),
                                 on_value);
      break;
    }
    case vOneHot::MODE_Y: {
      VfCall<OneHotSimtY<T>>(cce::dim3(kSimtThreadNum), xd, indices, static_cast<uint32_t>(op.dup_round),
                             static_cast<uint32_t>(op.iter_num), static_cast<uint32_t>(op.depth), on_value);
      break;
    }
    case vOneHot::MODE_Y_TILE: {
      uint32_t begin = static_cast<uint32_t>((TileIdx(tile) % op.dup_round) * op.depth);
      uint32_t end = begin + static_cast<uint32_t>(op.depth);
      VfCall<OneHotSimtYTile<T>>(cce::dim3(kSimtThreadNum), xd, indices, static_cast<uint32_t>(op.iter_num),
                                 begin, end, on_value);
      break;
    }
    case vOneHot::MODE_Y_TILE_2: {
      uint32_t begin = static_cast<uint32_t>((TileIdx(tile) % op.dup_round) / op.depth);
      VfCall<OneHotSimtYTile2<T>>(cce::dim3(kSimtThreadNum), xd, indices, static_cast<uint32_t>(op.iter_num),
                                  begin, on_value);
      break;
    }
    default:
      break;
  }
}

template <typename T>
__aicore_inline__ void RemovePad(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vRemovePad op;
  vRemovePad::Decode(pc, head, op);
  __ubuf__ T *xd = (__ubuf__ T *)(op.xd);
  __ubuf__ T *xn = (__ubuf__ T *)(op.xn);
  uint16_t repeat = op.repeat;
  uint32_t dst_num = op.rs << BlockDataShift(T);
  __VEC_SCOPE__ {
    RegTensor<T> vreg0;
    vector_align ureg;
    uint32_t sregLower = BlockNum(T);
    uint16_t count_repeat = op.iter_num / sregLower;
    uint16_t tail = op.iter_num - count_repeat * sregLower;
    for (uint16_t i = 0; i < repeat; ++i) {
      for (uint16_t j = 0; j < count_repeat; ++j) {
        vlds(vreg0, xn, i * dst_num + j * sregLower, NORM);
        vstus(ureg, sregLower, vreg0, xd, POST_UPDATE);
      }
      vlds(vreg0, xn, i * dst_num + count_repeat * sregLower, NORM);
      vstus(ureg, tail, vreg0, xd, POST_UPDATE);
    }
    vstas(ureg, xd, 0, POST_UPDATE);
  }
}

__aicore_inline__ void Custom(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vCustom op;
  vCustom::Decode(pc, op);
  preload(reinterpret_cast<const void *>(op.func_addr), 1);
  auto func = reinterpret_cast<OpFunc>(op.func_addr);
  func(pc + vCustom::PAYLOAD_OFFSET, head, tile);
}

__aicore_inline__ void Load(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vLoad op;
  vLoad::Decode(pc, head, op);
  uint64_t tile_idx = TileIdx(tile);
  uint64_t iter_size = op.iter_size;
  uint64_t body_iter = op.body_iter;

  if (op.round_rank > 0) {
    tile_idx = RoundUpTileIdx<kRoundCacheLoad>(tile, tile_idx, op.round_rank, pc + vLoad::ROUND_OFFSET);
    if (tile_idx == INVALID_INT) {
      return;
    }
  }
  __gm__ uint8_t* src = (__gm__ uint8_t*)op.from + op.tile_stride * tile_idx;
  if (IsLastTile(tile)) {
    if (body_iter == 1) {
      iter_size = op.tail_iter;
    } else {
      body_iter = op.tail_iter;
    }
  }
  __ubuf__ uint8_t *dst = (__ubuf__ uint8_t *)(op.xn);
  uint32_t dst_stride = op.pad_size + op.iter_size;
  uint32_t src_stride = op.iter_size;
  copy_gm_to_ubuf_align_v2(dst, src, 0, body_iter, iter_size, 0, 0, false, 0, src_stride, dst_stride);
  OVER_WRITE_CHECK(pc, head, op.tile_stride * tile_idx + body_iter * iter_size);
}

__aicore_inline__ void SliceLoad2D(__ubuf__ uint8_t *dst, __gm__ uint8_t *src, uint64_t begin_m, uint64_t end_m,
                                   uint64_t begin_n, uint64_t end_n, uint64_t slice_n, uint64_t src_n,
                                   uint64_t pad_size, uint64_t type_size) {
  if (begin_m == end_m && begin_n <= end_n) {
    copy_gm_to_ubuf_align_v2(dst, src, 0, 1, (end_n - begin_n + 1) * type_size, 0, 0, false, 0, 0, 0);
  } else if (begin_m < end_m) {
    uint64_t num = end_m - begin_m + 1;
    copy_gm_to_ubuf_align_v2(dst, src, 0, num, slice_n * type_size, 0, 0, false, 0, src_n * type_size,
                             (pad_size + slice_n) * type_size);
  }
}

__aicore_inline__ void SLoad(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vSLoad op;
  vShard2D shard;
  vSLoad::Decode(pc, head, op);
  vShard2D::Decode(pc + op.shard_rel, shard);
  uint64_t tile_idx = TileIdx(tile);
  uint64_t begin_tmp = op.tile_stride * tile_idx;
  uint64_t end_tmp = begin_tmp + op.tile_stride - 1;
  __ubuf__ uint8_t *dst = (__ubuf__ uint8_t *)(op.xn);
  __gm__ uint8_t *src = (__gm__ uint8_t *)op.gm;
  uint64_t shard_offset = shard.offset;
  uint64_t cidx = vGetBitRange(shard.pos, V_MM_POS_C_OFFSET, V_MM_POS_C_BITS);
  if (op.round_rank) {
    uint64_t base_cidx = cidx;
    cidx = RoundUpTileIdx<kRoundCacheNone>(tile, base_cidx, op.round_rank, pc + vSLoad::ROUND_OFFSET);
    shard_offset -= (base_cidx - cidx) * shard.stride_m;
  }
  if (op.broadcast_m) {
    if (op.broadcast_n) {
      src += cidx * op.type_size;
      copy_gm_to_ubuf_align_v2(dst, src, 0, 1, op.type_size, 0, 0, false, 0, 0, 0);
    } else {
      src += (cidx * shard.stride_n + shard_offset % shard.stride_n) * op.type_size;
      copy_gm_to_ubuf_align_v2(dst, src, 0, 1, op.tile_stride * op.type_size, 0, 0, false, 0, 0,
                               0);  // TODO: tail overflow
    }
  } else if (op.broadcast_n) {
    src += (shard_offset / shard.stride_n + begin_tmp) * op.type_size;
    copy_gm_to_ubuf_align_v2(dst, src, 0, 1, op.tile_stride * op.type_size, 0, 0, false, 0, 0,
                             0);  // TODO: tail overflow
  } else {
    uint64_t slice_m = shard.slice_m;
    uint64_t slice_n = shard.slice_n;
    uint64_t begin_m = begin_tmp / slice_n;
    uint64_t end_m = IsLastTile(tile) ? slice_m - 1 : end_tmp / slice_n;
    uint64_t begin_n = begin_tmp % slice_n;
    uint64_t end_n = IsLastTile(tile) ? slice_n - 1 : end_tmp % slice_n;
    uint64_t pad_size = op.pad_size;
    if (shard.last_m) {
      end_m = min(end_m, shard.tail_m - 1);
    }
    if (shard.last_n) {
      uint64_t tail_n = shard.tail_n;
      end_n = min(end_n, tail_n - 1);
      pad_size += slice_n - tail_n;
      slice_n = tail_n;
    }
    uint64_t offset_slice = begin_m * shard.stride_n + begin_n + shard_offset;
    src += offset_slice * op.type_size;
    SliceLoad2D(dst, src, begin_m, end_m, begin_n, end_n, slice_n, shard.stride_n, pad_size, op.type_size);
  }
}

__aicore_inline__ void PingPongLoad(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vPingPongLoad op;
  vPingPongLoad::Decode(pc, head, op);
  if (IsEndTile(tile)) {
    vPingPongLoad::PingPongSwitch(pc);
  }
  uint64_t tile_idx = TileIdx(tile);
  if (op.round_rank > 0) {
    tile_idx = RoundUpTileIdx<kRoundCacheLoad>(tile, tile_idx, op.round_rank, pc + vPingPongLoad::ROUND_OFFSET);
    if (tile_idx == INVALID_INT) {
      return;
    }
  }
  uint64_t blockgroup = vBlockGroup();
  uint64_t pingpong_offset = op.pingpong ? vGroupNum(blockgroup) + vGroupIdx(blockgroup) : vGroupIdx(blockgroup);
  __gm__ uint8_t *src = (__gm__ uint8_t *)op.from + pingpong_offset * op.pingpong_stride + op.tile_stride * tile_idx;
  __ubuf__ uint8_t *dst = (__ubuf__ uint8_t *)(op.xn);
  uint64_t truck_num = IsLastTile(tile) ? op.tail_iter : op.body_iter;
  if (op.pad_size == 0) {
    copy_gm_to_ubuf_align_v2(dst, src, 0, 1, truck_num * op.iter_size, 0, 0, false, 0, 0, 0);
  } else {
    copy_gm_to_ubuf_align_v2(dst, src, 0, truck_num, op.iter_size, 0, 0, false, 0, op.iter_size,
                             op.iter_size + op.pad_size);
  }
}

template <typename T>
__aicore_inline__ void nddma(__ubuf__ T *dst, __gm__ T *src, uint32_t loop0_size, uint32_t loop1_size,
                             uint32_t loop2_size, uint32_t loop3_size, uint32_t loop4_size,
                             uint64_t loop0_stride, uint64_t loop1_stride, uint64_t loop2_stride,
                             uint64_t loop3_stride, uint64_t loop4_stride) {
  set_pad_cnt_nddma(0);
  set_pad_val_nddma(0);
  set_loop0_stride_nddma(loop0_stride);
  set_loop1_stride_nddma(loop1_stride);
  set_loop2_stride_nddma(loop2_stride);
  set_loop3_stride_nddma(loop3_stride);
  set_loop4_stride_nddma(loop4_stride);
  set_pcie_rd_ctrl(0);
  if constexpr (sizeof(T) == 1) {
    nddma_out_to_ub_b8(dst, src, 0, loop0_size, loop1_size, loop2_size, loop3_size, loop4_size, 0, 0, true, 0);
  } else if constexpr (sizeof(T) == 2) {
    nddma_out_to_ub_b16(dst, src, 0, loop0_size, loop1_size, loop2_size, loop3_size, loop4_size, 0, 0, true, 0);
  } else {
    nddma_out_to_ub_b32(dst, src, 0, loop0_size, loop1_size, loop2_size, loop3_size, loop4_size, 0, 0, true, 0);
  }
}

__aicore_inline__ void ViewLoad(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vViewLoad op;
  vViewLoad::Decode(pc, head, op);
  uint64_t tile_idx = TileIdx(tile);
  uint64_t tile_offset = op.offset;
  uint64_t tile_space = 0;
  uint64_t tile_depth = op.tile_depth;
  for (; tile_depth > 0 && tile_idx > 0; --tile_depth) {
    uint64_t stride;
    vViewLoad::DecodeTile(pc[vViewLoad::VAR_OFFSET - 1 + op.loop_depth + tile_depth], tile_space, stride);
    uint64_t factor = tile_idx / tile_space;
    tile_offset += stride * factor;
    tile_idx -= factor * tile_space;
  }
  if (tile_space > 1 && tile_depth == 0 && tile_idx > 0 && !IsBeginTile(tile) && !IsSkipTile(tile)) {
    return;
  }
  __gm__ uint8_t *src = (__gm__ uint8_t *)op.from + tile_offset;
  __ubuf__ uint8_t *dst = (__ubuf__ uint8_t *)(op.xd);
  uint64_t iter_size = op.iter_size;
  uint64_t iter_num = op.iter_num;
  uint64_t src_stride = op.src_gap + op.iter_size;
  uint64_t dst_stride = (op.dst_gap + CeilDiv(op.iter_size, 32UL)) << 5;
  if (op.loop_depth == 0) {
    if (IsLastTile(tile)) {
      if (iter_num == 1) {
        iter_size = op.tail_size;
      } else {
        iter_num = op.tail_size;
      }
    }
    copy_gm_to_ubuf_align_v2(dst, src, 0, iter_num, iter_size, 0, 0, false, 0, src_stride, dst_stride);
  } else if (op.loop_depth == 1) {
    uint64_t loop_size, dst_loop_stride, src_loop_stride;
    vViewLoad::DecodeLoop(pc[vViewLoad::VAR_OFFSET], loop_size, dst_loop_stride, src_loop_stride);
    if (IsLastTile(tile)) {
      loop_size = op.tail_size;
    }
    set_loop_size_outtoub(loop_size | (1UL << 21));
    set_loop1_stride_outtoub((dst_loop_stride << 40) | src_loop_stride);
    copy_gm_to_ubuf_align_v2(dst, src, 0, op.iter_num, op.iter_size, 0, 0, false, 0, src_stride, dst_stride);
    set_loop_size_outtoub((1UL << 21) | 1UL);
  } else {
    uint64_t loop_size0, dst_loop_stride0, src_loop_stride0;
    uint64_t loop_size1, dst_loop_stride1, src_loop_stride1;
    vViewLoad::DecodeLoop(pc[vViewLoad::VAR_OFFSET], loop_size0, dst_loop_stride0, src_loop_stride0);
    vViewLoad::DecodeLoop(pc[vViewLoad::VAR_OFFSET + 1], loop_size1, dst_loop_stride1, src_loop_stride1);
    if (op.loop_depth == 2 && IsLastTile(tile)) {
      loop_size1 = op.tail_size;
    }
    set_loop_size_outtoub(loop_size0 | (loop_size1 << 21));
    set_loop1_stride_outtoub((dst_loop_stride0 << 40) | src_loop_stride0);
    set_loop2_stride_outtoub((dst_loop_stride1 << 40) | src_loop_stride1);

    uint32_t coord[6] = {0};
    uint64_t idx = 2;
    do {
      copy_gm_to_ubuf_align_v2(dst, src, 0, op.iter_num, op.iter_size, 0, 0, false, 0, src_stride, dst_stride);
      for (idx = 2; idx < op.loop_depth; ++idx) {
        uint64_t loop_size, dst_loop_stride, src_loop_stride;
        vViewLoad::DecodeLoop(pc[vViewLoad::VAR_OFFSET + idx], loop_size, dst_loop_stride, src_loop_stride);
        if (idx == op.loop_depth - 1 && IsLastTile(tile)) {
          loop_size = op.tail_size;
        }
        if (coord[idx] + 1 < loop_size) {
          coord[idx] += 1;
          dst += dst_loop_stride;
          src += src_loop_stride;
          idx = 0;
          break;
        }
        coord[idx] = 0;
        dst -= (loop_size - 1) * dst_loop_stride;
        src -= (loop_size - 1) * src_loop_stride;
      }
    } while (idx < op.loop_depth);
    set_loop_size_outtoub((1UL << 21) | 1UL);
  }
}

template <typename T>
__aicore_inline__ void ViewLoadXImpl(bcodeptr_t pc, const vViewLoadX &op, uint64_t tile_offset, bool is_last_tile) {
  __gm__ uint8_t *src = (__gm__ uint8_t *)(op.from + tile_offset);
  __ubuf__ uint8_t *dst = (__ubuf__ uint8_t *)(op.xd);
  uint64_t loop0_stride = ((op.iter_stride / sizeof(T)) << 20) | 1;
  if (likely(op.loop_depth <= 4)) {
    uint32_t loop_size[4] = {1, 1, 1, 1};
    uint64_t loop_stride[4] = {0, 0, 0, 0};
    for (uint64_t idx = 0; idx < op.loop_depth; ++idx) {
      uint64_t size, dst_stride, src_stride;
      vViewLoad::DecodeLoop(pc[vViewLoadX::VAR_OFFSET + idx], size, dst_stride, src_stride);
      if (idx == op.loop_depth - 1 && is_last_tile) {
        size = op.tail_size;
      }
      loop_size[idx] = static_cast<uint32_t>(size);
      loop_stride[idx] = ((src_stride / sizeof(T)) << 20) | ((dst_stride / sizeof(T)) & 0xfffff);
    }
    nddma((__ubuf__ T *)dst, (__gm__ T *)src, static_cast<uint32_t>(op.iter_size), loop_size[0], loop_size[1],
          loop_size[2], loop_size[3], loop0_stride, loop_stride[0], loop_stride[1], loop_stride[2], loop_stride[3]);
  } else {
    uint32_t coord[6] = {0};
    uint64_t idx = 0;
    do {
      nddma((__ubuf__ T *)dst, (__gm__ T *)src, static_cast<uint32_t>(op.iter_size), 1, 1, 1, 1, loop0_stride, 0, 0,
            0, 0);
      for (idx = 0; idx < op.loop_depth; ++idx) {
        uint64_t loop_size, dst_stride, src_stride;
        vViewLoad::DecodeLoop(pc[vViewLoadX::VAR_OFFSET + idx], loop_size, dst_stride, src_stride);
        if (idx == op.loop_depth - 1 && is_last_tile) {
          loop_size = op.tail_size;
        }
        if (coord[idx] + 1 < loop_size) {
          coord[idx] += 1;
          dst += dst_stride;
          src += src_stride;
          idx = 0;
          break;
        }
        coord[idx] = 0;
        dst -= (loop_size - 1) * dst_stride;
        src -= (loop_size - 1) * src_stride;
      }
    } while (idx < op.loop_depth);
  }
}

__aicore_inline__ void ViewLoadX(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vViewLoadX op;
  vViewLoadX::Decode(pc, head, op);
  bool is_last_tile = IsLastTile(tile);
  if (op.loop_depth == 0 && is_last_tile) {
    op.iter_size = op.tail_size;
  }
  uint64_t tile_idx = TileIdx(tile);
  uint64_t tile_offset = op.offset;
  uint64_t tile_space = 0;
  uint64_t tile_depth = op.tile_depth;
  for (; tile_depth > 0 && tile_idx > 0; --tile_depth) {
    uint64_t stride;
    vViewLoad::DecodeTile(pc[vViewLoadX::VAR_OFFSET - 1 + op.loop_depth + tile_depth], tile_space, stride);
    uint64_t factor = tile_idx / tile_space;
    tile_offset += stride * factor;
    tile_idx -= factor * tile_space;
  }
  if (tile_space > 1 && tile_depth == 0 && tile_idx > 0 && !IsBeginTile(tile) && !IsSkipTile(tile)) {
    return;
  }
  if (op.type_size == sizeof(uint8_t)) {
    ViewLoadXImpl<uint8_t>(pc, op, tile_offset, is_last_tile);
  } else if (op.type_size == sizeof(uint16_t)) {
    ViewLoadXImpl<uint16_t>(pc, op, tile_offset, is_last_tile);
  } else {
    ViewLoadXImpl<uint32_t>(pc, op, tile_offset, is_last_tile);
  }
}

template <typename T>
__aicore_inline__ void ViewLoadTImpl(bcodeptr_t pc, const vViewLoadT &op, uint64_t tile_offset, bool is_last_tile) {
  __gm__ uint8_t *src = (__gm__ uint8_t *)(op.from + tile_offset);
  __ubuf__ uint8_t *dst = (__ubuf__ uint8_t *)(op.xd);
  uint32_t iter_size = static_cast<uint32_t>(op.iter_size);
  if (op.loop_depth == 0 && is_last_tile) {
    iter_size = static_cast<uint32_t>(op.tail_size);
  }

  // w_gap is encoded as an unsigned 32-bit delta. Keep the 32-bit wrap so a
  // broadcast W stride (w_gap == -H * sizeof(T)) is reconstructed as zero.
  uint32_t w_stride_bytes = static_cast<uint32_t>(op.w_gap + op.h_fractal * sizeof(T));
  constexpr uint64_t block_items = 32 / sizeof(T);
  uint64_t dst_w_stride = CeilDiv(op.w_fractal, block_items) * block_items;
  uint64_t w_stride = ((static_cast<uint64_t>(w_stride_bytes) / sizeof(T)) << 20) | 1;
  uint64_t h_stride = (1UL << 20) | dst_w_stride;
  uint64_t iter_stride = ((op.iter_stride / sizeof(T)) << 20) | (dst_w_stride * op.h_fractal);

  uint32_t loop_size[2] = {1, 1};
  uint64_t loop_stride[2] = {0, 0};
  for (uint64_t idx = 0; idx < op.loop_depth && idx < 2; ++idx) {
    uint64_t size, dst_stride, src_stride;
    vViewLoad::DecodeLoop(pc[vViewLoadT::VAR_OFFSET + idx], size, dst_stride, src_stride);
    if (idx == op.loop_depth - 1 && is_last_tile) {
      size = op.tail_size;
    }
    loop_size[idx] = static_cast<uint32_t>(size);
    loop_stride[idx] = ((src_stride / sizeof(T)) << 20) | ((dst_stride / sizeof(T)) & 0xfffff);
  }

  if (likely(op.loop_depth <= 2)) {
    nddma((__ubuf__ T *)dst, (__gm__ T *)src, static_cast<uint32_t>(op.w_fractal),
          static_cast<uint32_t>(op.h_fractal), iter_size, loop_size[0], loop_size[1], w_stride, h_stride, iter_stride,
          loop_stride[0], loop_stride[1]);
    return;
  }

  uint32_t coord[6] = {0};
  uint64_t idx = 2;
  do {
    nddma((__ubuf__ T *)dst, (__gm__ T *)src, static_cast<uint32_t>(op.w_fractal),
          static_cast<uint32_t>(op.h_fractal), iter_size, loop_size[0], loop_size[1], w_stride, h_stride, iter_stride,
          loop_stride[0], loop_stride[1]);
    for (idx = 2; idx < op.loop_depth; ++idx) {
      uint64_t size, dst_stride, src_stride;
      vViewLoad::DecodeLoop(pc[vViewLoadT::VAR_OFFSET + idx], size, dst_stride, src_stride);
      if (idx == op.loop_depth - 1 && is_last_tile) {
        size = op.tail_size;
      }
      if (coord[idx] + 1 < size) {
        coord[idx] += 1;
        dst += dst_stride;
        src += src_stride;
        idx = 2;
        break;
      }
      coord[idx] = 0;
      dst -= (size - 1) * dst_stride;
      src -= (size - 1) * src_stride;
    }
  } while (idx < op.loop_depth);
}

__aicore_inline__ void ViewLoadT(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vViewLoadT op;
  vViewLoadT::Decode(pc, head, op);
  bool is_last_tile = IsLastTile(tile);
  uint64_t tile_idx = TileIdx(tile);
  uint64_t tile_offset = op.offset;
  uint64_t tile_space = 0;
  uint64_t tile_depth = op.tile_depth;
  for (; tile_depth > 0 && tile_idx > 0; --tile_depth) {
    uint64_t stride;
    vViewLoad::DecodeTile(pc[vViewLoadT::VAR_OFFSET - 1 + op.loop_depth + tile_depth], tile_space, stride);
    uint64_t factor = tile_idx / tile_space;
    tile_offset += stride * factor;
    tile_idx -= factor * tile_space;
  }
  if (tile_space > 1 && tile_depth == 0 && tile_idx > 0 && !IsBeginTile(tile) && !IsSkipTile(tile)) {
    return;
  }
  if (op.item_size == sizeof(uint16_t)) {
    ViewLoadTImpl<uint16_t>(pc, op, tile_offset, is_last_tile);
  } else {
    ViewLoadTImpl<uint32_t>(pc, op, tile_offset, is_last_tile);
  }
}

template <typename T>
__aicore_inline__ void GatherLoad(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vGatherLoad op;
  vGatherLoad::Decode(pc, head, op);
  uint64_t tile_idx = TileIdx(tile);
  if (op.round_rank > 0) {
    tile_idx = RoundUpTileIdx<kRoundCacheLoad>(tile, tile_idx, op.round_rank, pc + vGatherLoad::ROUND_OFFSET);
    if (tile_idx == INVALID_INT) {
      return;
    }
  }
  uint32_t body_iter = static_cast<uint32_t>(op.body_iter);
  uint32_t iter_size = static_cast<uint32_t>(op.iter_size);
  if (IsLastTile(tile)) {
    if (body_iter == 1) {
      iter_size = static_cast<uint32_t>(op.tail_iter);
    } else {
      body_iter = static_cast<uint32_t>(op.tail_iter);
    }
  }
  uint32_t total = body_iter * iter_size;
  uint32_t dup_num = static_cast<uint32_t>(op.body_iter * op.iter_size);
  uint32_t tile_base = dup_num * static_cast<uint32_t>(tile_idx);
  if (op.pad_size == 0) {
    if (op.gather_mode == vGatherLoad::kElementGather) {
      VfCall<GatherLoadSimtNoPad<T, vGatherLoad::kElementGather>>(cce::dim3(kGatherLoadSimtNoPadThreadNum),
                                                          (__ubuf__ T *)(op.xn), (__gm__ T *)(op.from),
                                                          (__gm__ int32_t *)(op.index), tile_base, total,
                                                          static_cast<uint32_t>(op.inner_size),
                                                          static_cast<uint32_t>(op.gather_size),
                                                          static_cast<uint32_t>(op.gather_dim_size));
    } else {
      VfCall<GatherLoadSimtNoPad<T, vGatherLoad::kSliceGather>>(cce::dim3(kGatherLoadSimtNoPadThreadNum),
                                                             (__ubuf__ T *)(op.xn), (__gm__ T *)(op.from),
                                                             (__gm__ int32_t *)(op.index), tile_base, total,
                                                             static_cast<uint32_t>(op.inner_size),
                                                             static_cast<uint32_t>(op.gather_size),
                                                             static_cast<uint32_t>(op.gather_dim_size));
    }
  } else {
    if (op.gather_mode == vGatherLoad::kElementGather) {
      VfCall<GatherLoadSimtPad<T, vGatherLoad::kElementGather>>(cce::dim3(kGatherLoadSimtPadThreadNum),
                                                        (__ubuf__ T *)(op.xn), (__gm__ T *)(op.from),
                                                        (__gm__ int32_t *)(op.index), tile_base, total, iter_size,
                                                        static_cast<uint32_t>(op.pad_size),
                                                        static_cast<uint32_t>(op.inner_size),
                                                        static_cast<uint32_t>(op.gather_size),
                                                        static_cast<uint32_t>(op.gather_dim_size));
    } else {
      VfCall<GatherLoadSimtPad<T, vGatherLoad::kSliceGather>>(cce::dim3(kGatherLoadSimtPadThreadNum),
                                                           (__ubuf__ T *)(op.xn), (__gm__ T *)(op.from),
                                                           (__gm__ int32_t *)(op.index), tile_base, total, iter_size,
                                                           static_cast<uint32_t>(op.pad_size),
                                                           static_cast<uint32_t>(op.inner_size),
                                                           static_cast<uint32_t>(op.gather_size),
                                                           static_cast<uint32_t>(op.gather_dim_size));
    }
  }
}

__aicore_inline__ void ViewStore(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vViewStore op;
  vViewStore::Decode(pc, head, op);
  uint64_t tile_idx = TileIdx(tile);
  uint64_t tile_offset = op.offset;
  for (uint64_t i = op.tile_depth; i > 0 && tile_idx > 0; --i) {
    uint64_t space, stride;
    vViewStore::DecodeTile(pc[vViewStore::VAR_OFFSET - 1 + op.loop_depth + i], space, stride);
    uint64_t factor = tile_idx / space;
    tile_offset += stride * factor;
    tile_idx -= factor * space;
  }
  __ubuf__ uint8_t *src = (__ubuf__ uint8_t *)(op.xn);
  __gm__ uint8_t *dst = (__gm__ uint8_t *)op.to + tile_offset;
  uint32_t dst_stride = op.iter_size + op.dst_gap;
  uint32_t src_stride = (op.src_gap + CeilDiv(op.iter_size, 32UL)) << 5;
  if (op.loop_depth == 0) {
    if (IsLastTile(tile)) {
      if (op.iter_num == 1) {
        op.iter_size = op.tail_size;
      } else {
        op.iter_num = op.tail_size;
      }
    }
    copy_ubuf_to_gm_align_v2(dst, src, 0, op.iter_num, op.iter_size, 0, dst_stride, src_stride);
  } else if (op.loop_depth == 1) {
    uint64_t loop_size, dst_loop_stride, src_loop_stride;
    vViewStore::DecodeLoop(pc[vViewStore::VAR_OFFSET], loop_size, dst_loop_stride, src_loop_stride);
    if (IsLastTile(tile)) {
      loop_size = op.tail_size;
    }
    set_loop_size_ubtoout(loop_size | (1UL << 21));
    set_loop1_stride_ubtoout((src_loop_stride << 40) | dst_loop_stride);
    copy_ubuf_to_gm_align_v2(dst, src, 0, op.iter_num, op.iter_size, 0, dst_stride, src_stride);
    set_loop_size_ubtoout((1UL << 21) | 1UL);
  } else {
    uint64_t loop_size0, dst_loop_stride0, src_loop_stride0;
    uint64_t loop_size1, dst_loop_stride1, src_loop_stride1;
    vViewStore::DecodeLoop(pc[vViewStore::VAR_OFFSET], loop_size0, dst_loop_stride0, src_loop_stride0);
    vViewStore::DecodeLoop(pc[vViewStore::VAR_OFFSET + 1], loop_size1, dst_loop_stride1, src_loop_stride1);
    if (op.loop_depth == 2 && IsLastTile(tile)) {
      loop_size1 = op.tail_size;
    }
    set_loop_size_ubtoout(loop_size0 | (loop_size1 << 21));
    set_loop1_stride_ubtoout((src_loop_stride0 << 40) | dst_loop_stride0);
    set_loop2_stride_ubtoout((src_loop_stride1 << 40) | dst_loop_stride1);

    uint32_t coord[6] = {0};
    uint64_t idx = 2;
    do {
      copy_ubuf_to_gm_align_v2(dst, src, 0, op.iter_num, op.iter_size, 0, dst_stride, src_stride);
      for (idx = 2; idx < op.loop_depth; ++idx) {
        uint64_t loop_size, dst_loop_stride, src_loop_stride;
        vViewStore::DecodeLoop(pc[vViewStore::VAR_OFFSET + idx], loop_size, dst_loop_stride, src_loop_stride);
        if (idx == op.loop_depth - 1 && IsLastTile(tile)) {
          loop_size = op.tail_size;
        }
        if (coord[idx] + 1 < loop_size) {
          coord[idx] += 1;
          dst += dst_loop_stride;
          src += src_loop_stride;
          idx = 2;
          break;
        }
        coord[idx] = 0;
        dst -= (loop_size - 1) * dst_loop_stride;
        src -= (loop_size - 1) * src_loop_stride;
      }
    } while (idx < op.loop_depth);
    set_loop_size_ubtoout((1UL << 21) | 1UL);
  }
}

__aicore_inline__ void ViewStoreX(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vViewStoreX op;
  vViewStoreX::Decode(pc, head, op);
  if (op.loop_depth == 0 && IsLastTile(tile)) {
    op.iter_size = op.tail_size;
  }
  uint64_t tile_idx = TileIdx(tile);
  uint64_t tile_offset = op.offset;
  for (uint64_t i = op.tile_depth; i > 0 && tile_idx > 0; --i) {
    uint64_t space, stride;
    vViewStore::DecodeTile(pc[vViewStoreX::VAR_OFFSET - 1 + op.loop_depth + i], space, stride);
    uint64_t factor = tile_idx / space;
    tile_offset += stride * factor;
    tile_idx -= factor * space;
  }
  __gm__ uint8_t *dst = (__gm__ uint8_t *)(op.to + tile_offset);
  __ubuf__ uint8_t *src = (__ubuf__ uint8_t *)(op.xn);
  uint32_t coord[6] = {0};
  uint64_t idx = 0;
  do {
    copy_ubuf_to_gm_align_v2(dst, src, 0, op.iter_size, op.type_size, 0, op.iter_stride, op.type_size);
    for (idx = 0; idx < op.loop_depth; ++idx) {
      uint64_t loop_size, dst_stride, src_stride;
      vViewStore::DecodeLoop(pc[vViewStoreX::VAR_OFFSET + idx], loop_size, dst_stride, src_stride);
      if (idx == op.loop_depth - 1 && IsLastTile(tile)) {
        loop_size = op.tail_size;
      }
      if (coord[idx] + 1 < loop_size) {
        coord[idx] += 1;
        dst += dst_stride;
        src += src_stride;
        idx = 0;
        break;
      }
      coord[idx] = 0;
      dst -= (loop_size - 1) * dst_stride;
      src -= (loop_size - 1) * src_stride;
    }
  } while (idx < op.loop_depth);
}

__aicore_inline__ void Store(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vStore op;
  vStore::Decode(pc, head, op);
  uint64_t tile_idx = TileIdx(tile);
  if (op.round_rank > 0) {
    tile_idx = RoundUpTileIdx<kRoundCacheStore>(tile, tile_idx, op.round_rank, pc + vStore::ROUND_OFFSET);
    if (tile_idx == INVALID_INT) {
      return;
    }
  }
  uint64_t iter_num = op.iter_num;
  uint64_t iter_size = op.iter_size;
  __gm__ uint8_t *dst = (__gm__ uint8_t*)op.to + op.tile_stride * tile_idx;
  if (IsLastTile(tile)) {
    if (iter_num == 1) {
      iter_size = op.iter_tail;
    } else {
      iter_num = op.iter_tail;
    }
  }
  uint32_t dst_stride = op.iter_size;
  uint32_t src_stride = iter_num == 1 ? 0 : op.pad_size + op.iter_size;
  copy_ubuf_to_gm_align_v2(dst, (__ubuf__ uint8_t *)(op.xn), 0, iter_num, iter_size, 0, dst_stride, src_stride);
  OVER_WRITE_CHECK(pc, head, op.tile_stride * tile_idx + iter_num * iter_size);
}

__aicore_inline__ void CondStore(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vStoreCond op;
  if (vStoreCond::Decode<true>(pc, head, op)) {
    uint64_t tile_idx = TileIdx(tile);
    if (op.round_rank > 0) {
      tile_idx = RoundUpTileIdx<kRoundCacheNone>(tile, tile_idx, op.round_rank, pc + vStoreCond::ROUND_OFFSET);
    }
    __gm__ uint8_t *dst = (__gm__ uint8_t *)op.to + op.tile_stride * tile_idx;
    if (op.pad_size == 0) {
      op.iter_offset = op.iter_offset << op.dtype_shift;
      op.iter_range = op.iter_range << op.dtype_shift;
      copy_ubuf_to_gm_align_v2(dst + op.iter_offset, (__ubuf__ uint8_t *)(op.xn + op.iter_offset), 0, 1, op.iter_range,
                               0, 0, 0);
      OVER_WRITE_CHECK(pc, head, op.tile_stride * tile_idx + op.iter_offset + op.iter_range);
    } else {
      uint64_t src_offset = op.iter_offset * (op.iter_size + op.pad_size);
      uint64_t dst_offset = op.iter_offset * op.iter_size;
      uint32_t dst_stride = op.iter_size;
      uint32_t src_stride = op.pad_size + op.iter_size;
      copy_ubuf_to_gm_align_v2(dst + dst_offset, (__ubuf__ uint8_t *)(op.xn + src_offset), 0, op.iter_range,
                               op.iter_size, 0, dst_stride, src_stride);
      OVER_WRITE_CHECK(pc, head, op.tile_stride * tile_idx + dst_offset + op.iter_range * op.iter_size);
    }
  }
}

__aicore_inline__ void StoreAtomic(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vStoreAtomic op;
  vStoreAtomic::Decode(pc, head, op);
  uint64_t tile_idx = TileIdx(tile);
  if (op.cum_flag) {
    tile_idx = RoundUpTileIdx<kRoundCacheStoreAtomic>(tile, tile_idx, op.round_rank, pc + vStoreAtomic::ROUND_OFFSET);
    if (tile_idx == INVALID_INT) {
      return;
    }
  } else {
    tile_idx = RoundUpTileIdx<kRoundCacheNone>(tile, tile_idx, op.round_rank, pc + vStoreAtomic::ROUND_OFFSET);
  }
  if (IsLastTile(tile)) {
    op.iter_num = op.iter_tail;
  }
  __gm__ uint8_t *gm = (__gm__ uint8_t *)op.to + op.tile_stride * tile_idx;
  uint64_t atomic_type = op.atomic_type == V_ATOMIC_BF16 ? ATOMIC_BF16 : op.atomic_type + 1;
  uint64_t ctrl = get_ctrl() & ~(0x1ful << 6);
  set_ctrl(ctrl | (atomic_type << 6) | (op.red_op << 9));
  if (op.pad_size == 0) {
    copy_ubuf_to_gm_align_v2(gm, (__ubuf__ void *)(op.xn), 0, 1, op.iter_num * op.iter_size, 0, 0, 0);
  } else {
    uint32_t src_stride = op.pad_size + op.iter_size;
    copy_ubuf_to_gm_align_v2(gm, (__ubuf__ void *)(op.xn), 0, op.iter_num, op.iter_size, 0, op.iter_size, src_stride);
  }
  set_atomic_none();
  OVER_WRITE_CHECK(pc, head, op.tile_stride * tile_idx + op.iter_num * op.iter_size);
}

__aicore_inline__ void StoreAtomicW(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vStoreAtomicW op;
  vStoreAtomicW::Decode(pc, head, op);
  if (op.round_rank == 1 || op.round_rank == 3) {
    bcodeptr_t rpc = pc + vStoreAtomicW::ROUND_OFFSET;
    if (RoundUpTileIdx<kRoundCacheStoreAtomic>(tile, TileIdx(tile), op.round_rank, rpc) == INVALID_INT) {
      return;
    }
  }
  uint64_t atomic_type = op.atomic_type == V_ATOMIC_BF16 ? ATOMIC_BF16 : op.atomic_type + 1;
  uint64_t ctrl = get_ctrl() & ~(0x1ful << 6);
  set_ctrl(ctrl | (atomic_type << 6) | (op.red_op << 9));
  pc = op.GetBody(pc, op);
  head = *pc;
  ((OpFunc)(GetFunc(head >> V_HEAD_ID_OFFSET, RegTable()->vm_code_base)))(pc, head, tile);
  set_atomic_none();
}

__aicore_inline__ void SliceStore2D(__gm__ uint8_t *dst, __ubuf__ uint8_t *src, uint64_t begin_m, uint64_t end_m,
                                    uint64_t begin_n, uint64_t end_n, uint64_t slice_n, uint64_t src_n,
                                    uint64_t pad_size, uint64_t type_size) {
  if (begin_m == end_m && begin_n <= end_n) {
    copy_ubuf_to_gm_align_v2(dst, src, 0, 1, (end_n - begin_n + 1) * type_size, 0, 0, 0);
  } else if (begin_m < end_m) {
    uint64_t num = end_m - begin_m + 1;
    copy_ubuf_to_gm_align_v2(dst, src, 0, num, slice_n * type_size, 0, src_n * type_size,
                             (pad_size + slice_n) * type_size);
  }
}

__aicore_inline__ void SStore(bcodeptr_t pc, uint64_t head, uint64_t tile) {
  vSStore op;
  vShard2D shard;
  vSStore::Decode(pc, head, op);
  vShard2D::Decode(pc + op.shard_rel, shard);
  uint64_t tile_idx = TileIdx(tile);
  uint64_t begin_tmp = op.tile_stride * tile_idx;
  __ubuf__ uint8_t *src = (__ubuf__ uint8_t *)op.xn;
  __gm__ uint8_t *dst = (__gm__ uint8_t *)op.gm;
  uint64_t cidx = vGetBitRange(shard.pos, V_MM_POS_C_OFFSET, V_MM_POS_C_BITS);
  uint64_t shard_offset = shard.offset;
  if (op.round_rank) {
    uint64_t base_cidx = cidx;
    cidx = RoundUpTileIdx<kRoundCacheNone>(tile, base_cidx, op.round_rank, pc + vSStore::ROUND_OFFSET);
    shard_offset -= (base_cidx - cidx) * shard.stride_m;
  }
  if (op.broadcast_m || op.broadcast_n) {
    uint64_t midx = vGetBitRange(shard.pos, V_MM_POS_M_OFFSET, V_MM_POS_M_BITS);
    uint64_t nidx = vGetBitRange(shard.pos, V_MM_POS_N_OFFSET, V_MM_POS_N_BITS);
    if (!op.broadcast_m) {
      if (uint64_t end_m = shard.last_m ? shard.tail_m : shard.slice_m; begin_tmp < end_m && nidx == 0) {
        dst += (shard_offset / shard.stride_n + begin_tmp) * op.type_size;
        copy_ubuf_to_gm_align_v2(dst, src, 0, 1, min(end_m - begin_tmp, op.tile_stride) * op.type_size, 0, 0, 0);
      }
    } else if (!op.broadcast_n) {
      if (uint64_t end_n = shard.last_n ? shard.tail_n : shard.slice_n; begin_tmp < end_n && midx == 0) {
        dst += (cidx * shard.stride_n + shard_offset % shard.stride_n) * op.type_size;
        copy_ubuf_to_gm_align_v2(dst, src, 0, 1, min(end_n - begin_tmp, op.tile_stride) * op.type_size, 0, 0, 0);
      }
    } else if (midx == 0 && nidx == 0 && tile_idx == 0) {
      dst += cidx * op.type_size;
      copy_ubuf_to_gm_align_v2(dst, src, 0, 1, op.type_size, 0, 0, 0);
    }
    return;
  }
  uint64_t end_tmp = begin_tmp + op.tile_stride - 1;
  uint64_t slice_m = shard.slice_m;
  uint64_t slice_n = shard.slice_n;
  uint64_t begin_m = begin_tmp  / slice_n;
  uint64_t end_m = IsLastTile(tile) ? slice_m - 1 : end_tmp  / slice_n;
  uint64_t begin_n = begin_tmp % slice_n;
  uint64_t end_n = IsLastTile(tile) ? slice_n - 1 : end_tmp % slice_n;
  if (shard.last_m) {
    end_m = min(end_m, shard.tail_m - 1);
  }
  uint64_t pad_size = op.pad_size;
  if (shard.last_n) {
    uint64_t tail_n = shard.tail_n;
    end_n = min(end_n, tail_n - 1);
    pad_size += slice_n - tail_n;
    slice_n = tail_n;
  }
  uint64_t offset_slice = begin_m * shard.stride_n + begin_n + shard_offset;
  dst += offset_slice * op.type_size;
  SliceStore2D(dst, src, begin_m, end_m, begin_n, end_n, slice_n, shard.stride_n, pad_size, op.type_size);
}

extern "C" __global__ __aicore__ void dvm_mix_aiv(uint64_t ffts_addr, uint64_t entry) {
  __gm__ uint8_t * body_addr = (__gm__ uint8_t*)(get_para_base()) + sizeof(ffts_addr) + sizeof(entry);
  if (entry & V_ENTRY_FLAG_EXTERN_CODE) {
    __gm__ uint64_t *ext_addr = reinterpret_cast<__gm__ uint64_t*>(ffts_addr);
    ffts_addr = *ext_addr;
    body_addr = reinterpret_cast<__gm__ uint8_t*>(ext_addr + 2);
  }
  uint64_t blockidx = get_subblockdim() * block_idx + get_subblockid();
  uint64_t blocknum = get_subblockdim() * block_num;
  uint64_t ktype = entry & V_ENTRY_MASK_TYPE;
  if (ktype == V_ENTRY_TYPE_P) {
    uint64_t lookup_offset = (entry >> V_ENTRY_P_AIV_LKUP_OFFSET) & V_ENTRY_P_LKUP_MASK;
    uint8_t prog_offset = *(body_addr + lookup_offset + blockidx);
    if (prog_offset != V_ENTRY_P_LKUP_INVALID) {
      vProgEntry prog;
      vProgEntry::Decode(reinterpret_cast<bcodeptr_t>(body_addr) + prog_offset, prog);
      entry = prog.entry;
      ktype = entry & V_ENTRY_MASK_TYPE;
      blockidx -= prog.b_begin;
      blocknum = prog.b_num;
      body_addr += prog.offset;
    }
  }
  set_atomic_none();
  uint8_t* main_addr = (uint8_t*)(VA_VMAIN_BASE);
  uint64_t tile = 0;
  uint64_t code_size = vGetBitRange(entry, V_ENTRY_CODE_SIZE_OFFSET, V_ENTRY_CODE_SIZE_BITS);
  if (ktype == V_ENTRY_TYPE_V) {
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t *)PC_BASE, (__gm__ uint8_t *)body_addr, 0, 1,
                             code_size * sizeof(uint64_t), 0, 0, false, 0, 0, 0);
    uint64_t count = vGetBitRange(entry, V_ENTRY_V_TILE_BODY_OFFSET, V_ENTRY_V_TILE_BODY_BITS);
    tile = (blockidx * count) << V_TILE_CUR_IDX_OFFSET;
    if (blockidx == blocknum - 1) {
      count -= vGetBitRange(entry, V_ENTRY_V_TILE_TAIL_OFFSET, V_ENTRY_V_TILE_TAIL_BITS);
      tile |= 1ul << V_TILE_TAIL_FLAG_OFFSET;
    }
    tile |= count << V_TILE_COUNT_OFFSET;
    vBlockInit(blockidx, blocknum);
    RegTable()->vm_code_base = main_addr;
    pipe_barrier(PIPE_ALL);
  } else if (ktype == V_ENTRY_TYPE_VE) {
    if (entry & V_ENTRY_FLAG_CUBE_MIX) {
      body_addr += sizeof(vCubeOp);
      code_size -= sizeof(vCubeOp) / sizeof(uint64_t);
      vBlockGroupInit(blockidx >> 1, blocknum >> 1);
    }
    copy_gm_to_ubuf_align_v2((__ubuf__ uint8_t *)PC_BASE, (__gm__ uint8_t *)body_addr, 0, 1,
                             code_size * sizeof(uint64_t), 0, 0, false, 0, 0, 0);
    set_flag(PIPE_MTE2, PIPE_S, EVENT_ID0);
    vBlockInit(blockidx, blocknum);
    uint64_t visit_id = vGetBitRange(entry, V_ENTRY_VE_VISIT_ID_OFFSET, V_ENTRY_VE_VISIT_ID_BITS);
    uint64_t visit_offset = vGetBitRange(entry, V_ENTRY_VE_VISIT_OFFSET_OFFSET, V_ENTRY_VE_VISIT_OFFSET_BITS);
    bcodeptr_t visit_code = reinterpret_cast<bcodeptr_t>(VA_BCODE_BASE_UB) + visit_offset;
    RegTable()->vm_code_base = main_addr;
    wait_flag(PIPE_MTE2, PIPE_S, EVENT_ID0);
    if (entry & V_ENTRY_FLAG_CUBE_MIX) {
      vVisitMix::UpdateCube(visit_code, body_addr - sizeof(vCubeOp));
    }
    tile = ((VisitFunc)GetFunc(visit_id, main_addr))(visit_code);
  }
  // Note: dvm_mix_aiv should be the first function in this file(inline function is not included)
  // We need that fact to calculate the right offset of dispatch functions
TILE_LOOP:
  uint64_t tile_stride = ((IsSkipTile(tile) ? PopSkipStride() : 1ul) << V_TILE_CUR_IDX_OFFSET) - (1ul << V_TILE_COUNT_OFFSET);
  while (uint64_t count = vGetBitRange(tile, V_TILE_COUNT_OFFSET, V_TILE_COUNT_BITS)) {
    if (count == 1) {
      tile |= 1ul << V_TILE_END_FLAG_OFFSET;
    }
    uint64_t back_wait_mask = IsBeginTile(tile) ? 0 : (1ul << V_HEAD_BACK_WAIT_OFFSET);
    uint64_t back_set_mask = IsEndTile(tile) ? 0 : (1ul << V_HEAD_BACK_SET_OFFSET);
    bcodeptr_t pc = reinterpret_cast<bcodeptr_t >(VA_BCODE_BASE_UB);
    for (uint64_t head = *pc; head != 0; head = *pc) {
      bcodeptr_t op_pc = pc;
      if (head & (0x1ul << V_HEAD_SIMD_FLAG_OFFSET)) {
        pc += (head >> V_HEAD_SIZE_OFFSET) & V_HEAD_SIZE_MASK;
        if (head & (0x1ul << V_HEAD_BAR_FLAG_OFFSET)) {
          // pipe_barrier(PIPE_V);
        }
        if (head & back_wait_mask) {
          event_t event = event_t((head >> V_HEAD_B_WAIT_EVENT_OFFSET) & V_HEAD_EVENT_MASK);
          wait_flag(PIPE_MTE3, PIPE_V, event);
        }
        if (head & (0x1ul << V_HEAD_WAIT_FLAG_OFFSET)) {
          event_t event = event_t((head >> V_HEAD_WAIT_EVENT_OFFSET) & V_HEAD_EVENT_MASK);
          wait_flag(PIPE_MTE2, PIPE_V, event);
        }
        ((OpFunc)(GetFunc(head >> V_HEAD_ID_OFFSET, main_addr)))(op_pc, head, tile);
        if (head & (0x1ul << V_HEAD_SET_FLAG_OFFSET)) {
          event_t event = event_t((head >> V_HEAD_SET_EVENT_OFFSET) & V_HEAD_EVENT_MASK);
          set_flag(PIPE_V, PIPE_MTE3, event);
        }
        if (head & back_set_mask) {
          event_t event = event_t((head >> V_HEAD_B_SET_EVENT_OFFSET) & V_HEAD_EVENT_MASK);
          set_flag(PIPE_V, PIPE_MTE2, event);
        }
      } else {
        pc += (head >> V_M_HEAD_SIZE_OFFSET) & V_M_HEAD_SIZE_MASK;
        ((OpFunc)(GetFunc(head >> V_HEAD_ID_OFFSET, main_addr)))(op_pc, head, tile);
      }
    }
    tile |= 1ul << V_TILE_N_BEGIN_FLAG_OFFSET;
    tile += tile_stride;
  }
  if ((entry & V_ENTRY_MASK_TYPE) == V_ENTRY_TYPE_VE) {
    set_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
    wait_flag(PIPE_MTE3, PIPE_MTE2, EVENT_ID0);
    uint64_t visit_id = vGetBitRange(entry, V_ENTRY_VE_VISIT_ID_OFFSET, V_ENTRY_VE_VISIT_ID_BITS);
    uint64_t visit_offset = vGetBitRange(entry, V_ENTRY_VE_VISIT_OFFSET_OFFSET, V_ENTRY_VE_VISIT_OFFSET_BITS);
    bcodeptr_t visit_code = reinterpret_cast<bcodeptr_t>(VA_BCODE_BASE_UB) + visit_offset;
    tile = ((VisitFunc)GetFunc(visit_id, main_addr))(visit_code);
    if (tile) {
      goto TILE_LOOP;
    }
  }
  pipe_barrier(PIPE_ALL);
}

#define DEF_NOINLINE_WRAPPER(name) \
  template <typename... Args> \
  __aicore__ __attribute__((noinline)) void name(Args... args) { \
    _##name(args...); \
  }

#define DEF_DISP_SIMD(OP, func) \
  extern "C" __aicore__ void D_##OP(bcodeptr_t pc, uint64_t head, uint64_t tile) { func; } \
  DEF_DRY_FUNC(g_simd_func_offset_c310, OP, D_##OP);

#define DEF_DISP_LOAD(OP, func)                                                               \
  extern "C" __aicore__ void D_##OP(bcodeptr_t pc, uint64_t head, uint64_t tile) {  \
    if ((head & (0x1ul << V_M_HEAD_WAIT_FLAG_OFFSET)) && !IsBeginTile(tile)) {                \
      event_t event = event_t((head >> V_M_HEAD_WAIT_EVENT_OFFSET) & V_HEAD_EVENT_MASK);      \
      wait_flag(PIPE_V, PIPE_MTE2, event);                                                    \
    }                                                                                         \
    func;                                                                                     \
    if (head & (0x1ul << V_M_HEAD_SET_FLAG_OFFSET)) {                                         \
      event_t event = event_t((head >> V_M_HEAD_SET_EVENT_OFFSET) & V_HEAD_EVENT_MASK);       \
      set_flag(PIPE_MTE2, PIPE_V, event);                                                     \
    }                                                                                         \
  }                                                                                           \
  DEF_DRY_FUNC(g_access_func_offset_c310, OP, D_##OP);

#define DEF_DISP_STORE(OP, func)                                                              \
  extern "C" __aicore__ void D_##OP(bcodeptr_t pc, uint64_t head, uint64_t tile) {  \
    if (head & (0x1ul << V_M_HEAD_WAIT_FLAG_OFFSET)) {                                        \
      event_t event = event_t((head >> V_M_HEAD_WAIT_EVENT_OFFSET) & V_HEAD_EVENT_MASK);      \
      wait_flag(PIPE_V, PIPE_MTE3, event);                                                    \
    }                                                                                         \
    func;                                                                                     \
    if ((head & (0x1ul << V_M_HEAD_SET_FLAG_OFFSET)) && !IsEndTile(tile)) {                   \
      event_t event = event_t((head >> V_M_HEAD_SET_EVENT_OFFSET) & V_HEAD_EVENT_MASK);       \
      set_flag(PIPE_MTE3, PIPE_V, event);                                                     \
    }                                                                                         \
  }                                                                                           \
  DEF_DRY_FUNC(g_access_func_offset_c310, OP, D_##OP);

#define DEF_DISP_VISIT(ID, func) \
  extern "C" __aicore__ uint64_t D_##ID(bcodeptr_t pc) { return func(pc); } \
  DEF_DRY_FUNC(g_visit_func_offset_c310, ID, D_##ID);

