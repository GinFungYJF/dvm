using AscendC::RoundMode;
using AscendC::MicroAPI::Cast;
using AscendC::MicroAPI::CastTrait;
using AscendC::MicroAPI::CreateMask;
using AscendC::MicroAPI::MaskMergeMode;
using AscendC::MicroAPI::MaskReg;
using AscendC::MicroAPI::MoveMask;
using AscendC::MicroAPI::RegLayout;
using AscendC::MicroAPI::SatMode;
using AscendC::MicroAPI::Truncate;

// RegTensor<int64_t> -> AscendC::MicroAPI::RegTensor<int64_t, RegTraitNumTwo>
template <typename T>
using RegTensor = AscendC::MicroAPI::RegTensor<
  T, std::is_same<T, int64_t>::value ? AscendC::MicroAPI::RegTraitNumTwo : AscendC::MicroAPI::RegTraitNumOne>;

// UpdateMask<int64_t> -> AscendC::MicroAPI::UpdateMask<int64_t, RegTraitNumTwo>
template <typename T>
__simd_callee__ __aicore_inline__ MaskReg UpdateMask(uint32_t &count) {
  return AscendC::MicroAPI::UpdateMask<T, RegTensor<T>::trait>(count);
}

template <size_t N>
struct SizeToUint;

template <>
struct SizeToUint<4> { using type = uint32_t; };

template <>
struct SizeToUint<2> { using type = uint16_t; };

template <typename T>
using UintFor = typename SizeToUint<sizeof(T)>::type;

constexpr uint32_t kSimtThreadNum = 2048;

template <RoundMode R>
constexpr CastTrait kCastTrait{RegLayout::ZERO, SatMode::SAT, MaskMergeMode::ZEROING, R};

template <typename T>
constexpr __aicore_inline__ DistVST DistSTValue() {
  if constexpr (sizeof(T) == 1) {
    return DistVST::DIST_NORM_B8;
  } else if constexpr (sizeof(T) == 2) {
    return DistVST::DIST_NORM_B16;
  }
  return DistVST::DIST_NORM_B32;
}

template <auto funcPtr, typename... Args>
__aicore__ inline void VfCall(cce::dim3 thread_nums, Args &&...args) {
  cce::async_invoke<funcPtr>(thread_nums, args...);
}

template <typename T>
__simt_vf__ inline void OneHotSimtX(__ubuf__ T *dst, __ubuf__ int32_t *indices, uint32_t iter_num, uint32_t depth,
                                    T on_value) {
  for (uint32_t i = threadIdx.x; i < iter_num; i += blockDim.x) {
    uint32_t indice = static_cast<uint32_t>(indices[i]);
    if (indice < depth) {
      dst[i * depth + indice] = on_value;
    }
  }
}

template <typename T>
__simt_vf__ inline void OneHotSimtXTile(__ubuf__ T *dst, __ubuf__ int32_t *indices, uint32_t begin, uint32_t depth,
                                        T on_value) {
  if (threadIdx.x == 0) {
    uint32_t indice = static_cast<uint32_t>(indices[0]);
    if (indice >= begin && indice < begin + depth) {
      dst[indice - begin] = on_value;
    }
  }
}

template <typename T>
__simt_vf__ inline void OneHotSimtY(__ubuf__ T *dst, __ubuf__ int32_t *indices, uint32_t dup_round,
                                    uint32_t iter_num, uint32_t depth, T on_value) {
  uint32_t total = dup_round * iter_num;
  for (uint32_t linear = threadIdx.x; linear < total; linear += blockDim.x) {
    uint32_t dup = linear / iter_num;
    uint32_t i = linear - dup * iter_num;
    uint32_t indice = static_cast<uint32_t>(indices[linear]);
    if (indice < depth) {
      dst[(depth * dup + indice) * iter_num + i] = on_value;
    }
  }
}

template <typename T>
__simt_vf__ inline void OneHotSimtYTile(__ubuf__ T *dst, __ubuf__ int32_t *indices, uint32_t iter_num,
                                        uint32_t begin, uint32_t end, T on_value) {
  for (uint32_t i = threadIdx.x; i < iter_num; i += blockDim.x) {
    uint32_t indice = static_cast<uint32_t>(indices[i]);
    if (indice >= begin && indice < end) {
      dst[(indice - begin) * iter_num + i] = on_value;
    }
  }
}

template <typename T>
__simt_vf__ inline void OneHotSimtYTile2(__ubuf__ T *dst, __ubuf__ int32_t *indices, uint32_t iter_num,
                                         uint32_t begin, T on_value) {
  for (uint32_t i = threadIdx.x; i < iter_num; i += blockDim.x) {
    uint32_t indice = static_cast<uint32_t>(indices[i]);
    if (indice == begin) {
      dst[i] = on_value;
    }
  }
}

constexpr uint32_t kGatherLoadSimtNoPadThreadNum = 1024;
constexpr uint32_t kGatherLoadSimtPadThreadNum = 1024;

template <typename T, uint32_t gather_mode>
__simt_vf__ inline void GatherLoadSimtNoPad(__ubuf__ T *dst, __gm__ T *src, __gm__ int32_t *index,
                                            uint32_t tile_base, uint32_t total, uint32_t inner_size,
                                            uint32_t gather_size, uint32_t gather_dim_size) {
  for (uint32_t i = threadIdx.x; i < total; i += blockDim.x) {
    uint32_t out_idx = tile_base + i;
    uint32_t gather_linear = out_idx / inner_size;
    uint32_t inner_idx = out_idx - gather_linear * inner_size;
    uint32_t outer_idx = gather_linear / gather_size;
    uint32_t gather_idx = gather_linear - outer_idx * gather_size;
    uint32_t index_offset = gather_idx;
    if constexpr (gather_mode == vGatherLoad::kElementGather) {
      index_offset = out_idx;
    }
    int32_t src_idx = index[index_offset];
    if (src_idx < 0) {
      src_idx += static_cast<int32_t>(gather_dim_size);
    }
    uint32_t src_offset = (outer_idx * gather_dim_size + static_cast<uint32_t>(src_idx)) * inner_size + inner_idx;
    dst[i] = (src_idx < 0 || static_cast<uint32_t>(src_idx) >= gather_dim_size) ? 0 : src[src_offset];
  }
}

template <typename T, uint32_t gather_mode>
__simt_vf__ inline void GatherLoadSimtPad(__ubuf__ T *dst, __gm__ T *src, __gm__ int32_t *index,
                                          uint32_t tile_base, uint32_t total, uint32_t iter_size, uint32_t pad_size,
                                          uint32_t inner_size, uint32_t gather_size, uint32_t gather_dim_size) {
  for (uint32_t i = threadIdx.x; i < total; i += blockDim.x) {
    uint32_t row = i / iter_size;
    uint32_t dst_idx = i + row * pad_size;
    uint32_t out_idx = tile_base + i;
    uint32_t gather_linear = out_idx / inner_size;
    uint32_t inner_idx = out_idx - gather_linear * inner_size;
    uint32_t outer_idx = gather_linear / gather_size;
    uint32_t gather_idx = gather_linear - outer_idx * gather_size;
    uint32_t index_offset = gather_idx;
    if constexpr (gather_mode == vGatherLoad::kElementGather) {
      index_offset = out_idx;
    }
    int32_t src_idx = index[index_offset];
    if (src_idx < 0) {
      src_idx += static_cast<int32_t>(gather_dim_size);
    }
    uint32_t src_offset = (outer_idx * gather_dim_size + static_cast<uint32_t>(src_idx)) * inner_size + inner_idx;
    dst[dst_idx] = (src_idx < 0 || static_cast<uint32_t>(src_idx) >= gather_dim_size) ? 0 : src[src_offset];
  }
}

#define DECLARE_BINARY(builtin)                                                                                        \
  template <typename T>                                                                                                \
  __aicore_inline__ void builtin##_count(__ubuf__ T *dst, __ubuf__ T *src0, __ubuf__ T *src1, uint32_t count) {        \
    __VEC_SCOPE__ {                                                                                                    \
      RegTensor<T> vreg0;                                                                                              \
      RegTensor<T> vreg1;                                                                                              \
      RegTensor<T> vreg2;                                                                                              \
      vector_bool stPreg;                                                                                              \
      uint32_t sregLower = BlockNum(T);                                                                                \
      uint16_t repeat = CeilDiv(count, sregLower);                                                                     \
      constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();                                  \
      for (uint16_t i = 0; i < repeat; ++i) {                                                                          \
        stPreg = UpdateMask<T>(count);                                                                                 \
        if constexpr (sizeof(T) == 8) {                                                                                \
          vlds((vector_2xvl_s64 &)vreg0, src0, i * sregLower);                                                         \
          vlds((vector_2xvl_s64 &)vreg1, src1, i * sregLower);                                                         \
          builtin((vector_2xvl_s64 &)vreg2, (vector_2xvl_s64 &)vreg0, (vector_2xvl_s64 &)vreg1, stPreg, MODE_ZEROING); \
          vsts((vector_2xvl_s64 &)vreg2, dst, i * sregLower, stPreg);                                                  \
        } else {                                                                                                       \
          vlds(vreg0, src0, i * sregLower, NORM);                                                                      \
          vlds(vreg1, src1, i * sregLower, NORM);                                                                      \
          builtin(vreg2, vreg0, vreg1, stPreg, MODE_ZEROING);                                                          \
          vsts(vreg2, dst, i * sregLower, distValue, stPreg);                                                          \
        }                                                                                                              \
      }                                                                                                                \
    }                                                                                                                  \
  }

#define DECLARE_BINARY_MASK(builtin)                                                                          \
  template <typename T>                                                                                       \
  __aicore_inline__ void builtin##_mask(__ubuf__ T *dst, __ubuf__ T *src0, __ubuf__ T *src1, uint16_t repeat, \
                                        uint32_t dst_offset, uint32_t src0_offset, uint32_t src1_offset) {    \
    __VEC_SCOPE__ {                                                                                           \
      RegTensor<T> vreg0;                                                                                     \
      RegTensor<T> vreg1;                                                                                     \
      RegTensor<T> vreg2;                                                                                     \
      vector_bool stPreg = MoveMask<T>();                                                                     \
      constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();                         \
      for (uint16_t i = 0; i < repeat; ++i) {                                                                 \
        vlds(vreg0, src0, i * src0_offset, NORM);                                                             \
        vlds(vreg1, src1, i * src1_offset, NORM);                                                             \
        builtin(vreg2, vreg0, vreg1, stPreg, MODE_ZEROING);                                                   \
        vsts(vreg2, dst, i * dst_offset, distValue, stPreg);                                                  \
      }                                                                                                       \
    }                                                                                                         \
  }

#define DECLARE_CBINARY_MASK(builtin)                                                                            \
  template <typename T>                                                                                          \
  __aicore_inline__ void builtin##_mask(__ubuf__ T *dst, __ubuf__ T *src0, uint16_t repeat, uint32_t dst_offset, \
                                        uint32_t src0_offset) {                                                  \
    __VEC_SCOPE__ {                                                                                              \
      RegTensor<T> vreg0;                                                                                        \
      RegTensor<T> vreg1;                                                                                        \
      vector_align ureg;                                                                                         \
      vector_bool exPreg = MoveMask<T>();                                                                        \
      for (uint16_t i = 0; i < repeat; ++i) {                                                                    \
        vlds(vreg0, src0, i *src0_offset, NORM);                                                                 \
        builtin(vreg1, vreg0, exPreg, MODE_ZEROING);                                                             \
        vstus(ureg, dst_offset, vreg1, dst, POST_UPDATE);                                                        \
      }                                                                                                          \
      vstas(ureg, dst, 0, POST_UPDATE);                                                                          \
    }                                                                                                            \
  }

#define DECLARE_UNARY(builtin)                                                                \
  template <typename T>                                                                       \
  __aicore_inline__ void builtin##_count(__ubuf__ T *dst, __ubuf__ T *src0, uint32_t count) { \
    __VEC_SCOPE__ {                                                                           \
      RegTensor<T> vreg0;                                                                     \
      RegTensor<T> vreg1;                                                                     \
      vector_bool stPreg;                                                                     \
      uint32_t sregLower = BlockNum(T);                                                       \
      uint16_t repeat = CeilDiv(count, sregLower);                                            \
      constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();         \
      for (uint16_t i = 0; i < repeat; ++i) {                                                 \
        stPreg = UpdateMask<T>(count);                                                        \
        vlds(vreg0, src0, i *sregLower, NORM);                                                \
        builtin(vreg1, vreg0, stPreg, MODE_ZEROING);                                          \
        vsts(vreg1, dst, i *sregLower, distValue, stPreg);                                    \
      }                                                                                       \
    }                                                                                         \
  }

#define DECLARE_BINARYS(builtin)                                                                        \
  template <typename T>                                                                                 \
  __aicore_inline__ void builtin##_count(__ubuf__ T *dst, __ubuf__ T *src0, T scalar, uint32_t count) { \
    __VEC_SCOPE__ {                                                                                     \
      RegTensor<T> vreg0;                                                                               \
      RegTensor<T> vreg1;                                                                               \
      vector_bool stPreg;                                                                               \
      uint32_t sregLower = BlockNum(T);                                                                 \
      uint16_t repeat = CeilDiv(count, sregLower);                                                      \
      constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();                   \
      for (uint16_t i = 0; i < repeat; ++i) {                                                           \
        stPreg = UpdateMask<T>(count);                                                                  \
        vlds(vreg0, src0, i *sregLower, NORM);                                                          \
        builtin(vreg1, vreg0, scalar, stPreg, MODE_ZEROING);                                            \
        vsts(vreg1, dst, i *sregLower, distValue, stPreg);                                              \
      }                                                                                                 \
    }                                                                                                   \
  }

#define DECLARE_BINARYS_EXT(builtin)                                                                    \
  template <typename T, bool IsRhs>                                                                     \
  __aicore_inline__ void builtin##_count(__ubuf__ T *dst, __ubuf__ T *src0, T scalar, uint32_t count) { \
    __VEC_SCOPE__ {                                                                                     \
      RegTensor<T> vreg0;                                                                               \
      RegTensor<T> vreg1;                                                                               \
      RegTensor<T> vscalar;                                                                             \
      vector_bool stPreg;                                                                               \
      uint32_t sregLower = BlockNum(T);                                                                 \
      uint16_t repeat = CeilDiv(count, sregLower);                                                      \
      vbr(vscalar, scalar);                                                                             \
      constexpr auto distValue = std::integral_constant<DistVST, DistSTValue<T>()>();                   \
      for (uint16_t i = 0; i < repeat; ++i) {                                                           \
        stPreg = UpdateMask<T>(count);                                                                  \
        vlds(vreg0, src0, i * sregLower, NORM);                                                         \
        if constexpr (IsRhs) {                                                                          \
          builtin(vreg1, vreg0, vscalar, stPreg, MODE_ZEROING);                                         \
        } else {                                                                                        \
          builtin(vreg1, vscalar, vreg0, stPreg, MODE_ZEROING);                                         \
        }                                                                                               \
        vsts(vreg1, dst, i * sregLower, distValue, stPreg);                                             \
      }                                                                                                 \
    }                                                                                                   \
  }

